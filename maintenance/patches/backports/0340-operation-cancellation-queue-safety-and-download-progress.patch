+        return new PackageBuilder().WithManager(manager).Build();
+    }
+
+    [Fact]
+    public async Task AnExistingFileMatchingThePublishedHashIsNotDownloadedAgain()
+    {
+        byte[] payload = new byte[64 * 1024];
+        new Random(53).NextBytes(payload);
+
