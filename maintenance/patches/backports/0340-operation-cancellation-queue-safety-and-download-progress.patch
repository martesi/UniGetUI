+
+    [Fact]
+    public async Task AnIntegrityHashFromANonSha256ManagerAlsoSkipsTheDownload()
+    {
+        byte[] payload = new byte[64 * 1024];
+        new Random(67).NextBytes(payload);
+
+        IPackage package = CreatePackageWithHash(
