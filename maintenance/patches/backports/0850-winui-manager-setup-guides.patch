diff --git a/src/UniGetUI/Pages/SettingsPages/ManagersPages/PackageManager.xaml.cs b/src/UniGetUI/Pages/SettingsPages/ManagersPages/PackageManager.xaml.cs
index 7c854741a58d168adb03fad494532f7b24234a88..0945791d919412e4d96199b878bd03505a603645 100644
--- a/src/UniGetUI/Pages/SettingsPages/ManagersPages/PackageManager.xaml.cs
+++ b/src/UniGetUI/Pages/SettingsPages/ManagersPages/PackageManager.xaml.cs
@@ -603,6 +603,16 @@ void ApplyManagerState(bool ShowVersion = false)
             if (Manager is null)
                 throw new InvalidDataException();
 
+            SetupGuideLink.Content = CoreTools.Translate("How to set up {0}", Manager.DisplayName);
+            string setupGuide = Manager.Properties.SetupGuide;
+            SetupGuideLink.NavigateUri = string.IsNullOrWhiteSpace(setupGuide)
+                ? null
+                : new Uri($"https://github.com/Devolutions/UniGetUI/blob/main/docs/{setupGuide}");
+            SetupGuideLink.Visibility =
+                !_isLoading && !Manager.IsReady() && SetupGuideLink.NavigateUri is not null
+                    ? Visibility.Visible
+                    : Visibility.Collapsed;
+
             // Load version and manager path
             ShowVersionHyperlink.Visibility = Visibility.Collapsed;
             LongVersionTextBlock.Visibility = Visibility.Collapsed;
