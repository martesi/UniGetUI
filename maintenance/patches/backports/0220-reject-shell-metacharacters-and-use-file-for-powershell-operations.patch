+
+    private static IPackage PowerShell7Package(PowerShell7 manager, string id = "Devolutions.PowerShell")
+        => Assert.Single(PowerShell7.ParseInstalledPackages(
+            ["##SCOPE:CurrentUser##", $"{id}\t1.0.0\tPSGallery"],
