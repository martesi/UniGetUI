+        /// </summary>
+        public static bool IsOptionSafeValue(string value)
+        {
+            if (value.Length is 0)
+                return true;
+
+            if (value[0] is '-' or '/')
+                return false;
+
+            foreach (char character in value)
+            {
+                if (char.IsControl(character))
+                    return false;
+            }
+
+            return true;
+        }
+
+        /// <summary>
