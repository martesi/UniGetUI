+    {
+        string[] arguments = [uri, "--set-setting-value", "ParallelOperationCount", "100"];
+
+        Assert.Equal([uri], SharedPreUiCommandDispatcher.IgnoreArgumentsInjectedIntoProtocolLaunch(arguments));
