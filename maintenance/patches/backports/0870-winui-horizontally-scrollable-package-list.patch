+                IsChecked = ColumnsFitToWindow,
+            };
+            fitItem.Click += (_, _) =>
+            {
+                Settings.Set(Settings.K.DisablePackageListColumnAutoFit, !fitItem.IsChecked);
+                ColumnVisibilityChanged?.Invoke();
+            };
+            items.Add(fitItem);
+            _fitColumnMenuItems.Add(fitItem);
+        }
