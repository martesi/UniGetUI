+    [Fact]
+    public void OriginalStringIsPreserved()
+    {
+        Assert.True(PythonVersion.TryParse("1.0.0RC1", out var parsed));
+        Assert.Equal("1.0.0RC1", parsed.Original);
+    }
+}
