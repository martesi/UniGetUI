+    private sealed class PackageBuilderFor(BaseNuGet manager, IManagerSource source)
+    {
+        public Package Build(string id, string version, string? scope = null)
+        {
+            return new Package(
+                id,
+                id,
+                version,
+                source,
+                manager,
+                scope is null ? null : new OverridenInstallationOptions(scope)
+            );
+        }
