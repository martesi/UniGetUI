+    [Theory]
+    [InlineData("1.0.0rc1", true)]
+    [InlineData("1.0.0a1", true)]
+    [InlineData("1.0.0.dev1", true)]
+    [InlineData("1.0.0a1.dev1", true)]
+    [InlineData("1.0.0", false)]
+    [InlineData("1.0.0.post1", false)]
+    [InlineData("1.0.0+local", false)]
