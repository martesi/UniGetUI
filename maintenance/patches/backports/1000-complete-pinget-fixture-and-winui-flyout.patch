From 76ad09b3137a1fbf97ea8cdaf59f952926b7812d Mon Sep 17 00:00:00 2001
From: dot <dot@users.noreply.github.com>
Date: Tue, 24 Nov 2026 11:57:23 -0800
Subject: [PATCH] Complete Pinget test fixture and expand WinUI flyout by state

Classic-Source-Commit: 76ad09b3137a1fbf97ea8cdaf59f952926b7812d
---
 .../WinGetManagerTests.cs                     | 14 +++++++-
 testing/automation/run-winui-ui-e2e.ps1       | 36 ++++++++++++++-----
 2 files changed, 40 insertions(+), 10 deletions(-)

diff --git a/src/UniGetUI.PackageEngine.Tests/WinGetManagerTests.cs b/src/UniGetUI.PackageEngine.Tests/WinGetManagerTests.cs
index 089dce8b..5636d91d 100644
--- a/src/UniGetUI.PackageEngine.Tests/WinGetManagerTests.cs
+++ b/src/UniGetUI.PackageEngine.Tests/WinGetManagerTests.cs
@@ -2439,7 +2439,19 @@ public sealed class WinGetManagerTests : IDisposable
         var result = RunPingetNoUpgradeResult(
             manager,
             package,
-            _ => ListResponseWith([new ListMatch { Name = "Contoso Tool", AvailableVersion = "2.0.0" }], [])
+            _ => ListResponseWith(
+                [
+                    new ListMatch
+                    {
+                        Name = "Contoso Tool",
+                        Id = "Contoso.Tool",
+                        LocalId = "Contoso.Tool",
+                        InstalledVersion = "1.0.0",
+                        AvailableVersion = "2.0.0",
+                    },
+                ],
+                []
+            )
         );
 
         OperationAssert.HasVeredict(result, OperationVeredict.Failure);
diff --git a/testing/automation/run-winui-ui-e2e.ps1 b/testing/automation/run-winui-ui-e2e.ps1
index bf16f389..022bd17d 100644
--- a/testing/automation/run-winui-ui-e2e.ps1
+++ b/testing/automation/run-winui-ui-e2e.ps1
@@ -87,9 +87,18 @@ function Invoke-Element {
 }
 
 function Open-ColumnToggle {
-    param([System.Windows.Automation.AutomationElement] $Root, [string] $Column)
+    param(
+        [System.Windows.Automation.AutomationElement] $Root,
+        [System.Windows.Automation.ExpandCollapsePattern] $OrderMenu,
+        [string] $Column,
+        [string] $Phase
+    )
 
-    Invoke-Element (Find-ElementByAutomationId $Root 'OrderByButton')
+    $menuState = $OrderMenu.Current.ExpandCollapseState
+    Write-Host "Columns menu for '$Column' (${Phase}): order flyout is $menuState"
+    if ($menuState -ne [System.Windows.Automation.ExpandCollapseState]::Expanded) {
+        $OrderMenu.Expand()
+    }
     $columnsMenu = Find-ElementByAutomationId $Root 'ColumnsMenu'
     try {
         $expand = [System.Windows.Automation.ExpandCollapsePattern]$columnsMenu.GetCurrentPattern(
@@ -118,14 +127,23 @@ function Set-ColumnVisibility {
     $expected = if ($Visible) { [System.Windows.Automation.ToggleState]::On } else {
         [System.Windows.Automation.ToggleState]::Off
     }
-    $toggle = Open-ColumnToggle $Root $Column
-    if ($toggle.Current.ToggleState -ne $expected) {
-        $toggle.Toggle()
-        $toggle = Open-ColumnToggle $Root $Column
+    $orderButton = Find-ElementByAutomationId $Root 'OrderByButton'
+    $orderMenu = [System.Windows.Automation.ExpandCollapsePattern]$orderButton.GetCurrentPattern(
+        [System.Windows.Automation.ExpandCollapsePattern]::Pattern
+    )
+    try {
+        $toggle = Open-ColumnToggle $Root $orderMenu $Column 'initial'
+        if ($toggle.Current.ToggleState -ne $expected) {
+            $toggle.Toggle()
+            $toggle = Open-ColumnToggle $Root $orderMenu $Column 'after toggle'
+        }
+        $actual = $toggle.Current.ToggleState
+    }
+    finally {
+        if ($orderMenu.Current.ExpandCollapseState -eq [System.Windows.Automation.ExpandCollapseState]::Expanded) {
+            $orderMenu.Collapse()
+        }
     }
-
-    $actual = $toggle.Current.ToggleState
-    [System.Windows.Forms.SendKeys]::SendWait('{ESC}{ESC}')
     if ($actual -ne $expected) {
         throw "Columns menu item '$Column' was $actual, expected $expected."
     }
