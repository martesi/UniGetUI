+        }
+    }
+
+    public static void TryAddToGlobalLock(string name, JsonObject entry)
+    {
+        try
+        {
+            SkillLock.AddSkill(name, entry);
+        }
+        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
+        {
