new file mode 100644
index 0000000..edd8f5e
--- /dev/null
+++ b/src/UniGetUI.Extensions.AgentSkills/AgentSkillsBackend.cs
@@ -0,0 +1,112 @@
+using Devolutions.AgentSkills;
+using UniGetUI.Core.SecureSettings;
+using AgentSkillsClient = Devolutions.AgentSkills.SkillsManager;
+
+namespace UniGetUI.Extensions.AgentSkills;
+
+/// <summary>
+/// <see cref="ISkillsBackend"/> over the bundled Agent Skills library, which installs skills in
+/// process, using the shared agent skills folders and lock files.
+/// </summary>
+/// <param name="homeDirectory">Home directory override, for tests; the user's home when null</param>
+internal sealed class AgentSkillsBackend(string? homeDirectory = null) : ISkillsBackend
+{
+    public string Version => AgentSkillsClient.Version;
+
+    // A client takes its options when it is created, and creating one is cheap, so each call gets
+    // one built with the current GitHub sign-in.
+    private AgentSkillsClient CreateClient(bool useGitHubToken = false) => new(CreateOptions(useGitHubToken));
+
+    /// <summary>
+    /// The Notion CLI is passed by path, since one that UniGetUI just installed
+    /// is not on this process's PATH yet.
+    /// </summary>
+    internal SkillsManagerOptions CreateOptions(bool useGitHubToken) =>
+        new()
+        {
+            HomeDirectory = homeDirectory,
+            GitHubToken = useGitHubToken ? GetGitHubToken() : null,
+            NotionCliPath = NotionCliTool.FindExecutable(),
+        };
+
+    /// <summary>
+    /// The token of the GitHub account signed in to UniGetUI (for cloud backups), which lifts
+    /// GitHub's anonymous rate limit of 60 API requests per hour. It is never sent to a GitHub
+    /// Enterprise host selected with GH_HOST. Without it, the library falls back to the
+    /// GITHUB_TOKEN and GH_TOKEN environment variables.
+    /// </summary>
+    private static string? GetGitHubToken()
+    {
+        string? host = Environment.GetEnvironmentVariable("GH_HOST")?.Trim();
+        if (!string.IsNullOrEmpty(host) && !host.Equals("github.com", StringComparison.OrdinalIgnoreCase))
+            return null;
+
+        return SecureGHTokenManager.GetToken();
+    }
+
+    public IReadOnlyList<AgentInfo> GetAgents() => CreateClient().GetAgents();
+
+    public IReadOnlyList<InstalledSkillInfo> GetInstalledSkills(CancellationToken cancellationToken) =>
+        CreateClient().GetInstalledSkills(SkillScope.Global, cancellationToken);
+
+    public IReadOnlyList<AvailableSkill> GetAvailableSkills(
+        string source,
+        IProgress<string>? progress,
+        CancellationToken cancellationToken
+    ) => CreateClient(useGitHubToken: true).GetAvailableSkills(source, false, progress, cancellationToken);
+
+    public SkillPreview PreviewSkill(string source, string skill, CancellationToken cancellationToken) =>
+        CreateClient(useGitHubToken: true).PreviewSkill(source, skill, cancellationToken);
+
+    public SkillInstallResult Install(
+        string source,
+        string skill,
+        IReadOnlyList<string>? agents,
+        IProgress<string>? progress,
+        CancellationToken cancellationToken
+    ) =>
+        CreateClient(useGitHubToken: true)
+            .Install(
+                new SkillInstallRequest
+                {
+                    Source = source,
+                    Skills = [skill],
+                    Agents = agents,
+                    Scope = SkillScope.Global,
+                },
+                progress,
+                cancellationToken
+            );
+
+    public SkillUpdateCheckResult CheckForUpdates(
+        IReadOnlyList<string>? skills,
+        IProgress<string>? progress,
+        CancellationToken cancellationToken
+    ) =>
+        CreateClient(useGitHubToken: true)
+            .CheckForUpdates(SkillScope.Global, skills, progress, cancellationToken);
+
+    public SkillUpdateResult Update(
+        IReadOnlyList<SkillUpdate> updates,
+        IProgress<string>? progress,
+        CancellationToken cancellationToken
+    ) => CreateClient(useGitHubToken: true).Update(updates, progress, cancellationToken);
+
+    public SkillRemoveResult Remove(
+        string skill,
+        IProgress<string>? progress,
+        CancellationToken cancellationToken
+    ) => CreateClient().Remove([skill], SkillScope.Global, null, progress, cancellationToken);
+
+    public NotionStatus GetNotionStatus(CancellationToken cancellationToken) =>
+        CreateClient().GetNotionStatus(cancellationToken);
+
+    public NotionSignIn BeginNotionSignIn(CancellationToken cancellationToken) =>
+        CreateClient().BeginNotionSignIn(cancellationToken);
+
+    public void CompleteNotionSignIn(CancellationToken cancellationToken) =>
+        CreateClient().CompleteNotionSignIn(cancellationToken);
+
+    public void SignOutOfNotion(CancellationToken cancellationToken) =>
+        CreateClient().SignOutOfNotion(cancellationToken);
+}
diff --git a/src/UniGetUI.Extensions.AgentSkills/AgentSkillsService.cs b/src/UniGetUI.Extensions.AgentSkills/AgentSkillsService.cs
new file mode 100644
index 0000000..1705546
--- /dev/null
+++ b/src/UniGetUI.Extensions.AgentSkills/AgentSkillsService.cs
@@ -0,0 +1,407 @@
+using System.Collections.Concurrent;
+using Devolutions.AgentSkills;
+using UniGetUI.Core.Data;
+using UniGetUI.Core.Logging;
+using UniGetUI.Core.SettingsEngine;
+using UniGetUI.Core.Tools;
+
+namespace UniGetUI.Extensions.AgentSkills;
+
+public enum SkillAction { Install, Update, Remove }
+public enum SkillDiscoveryScope { All, Sources, PublicCatalog }
+
+public sealed record SourceAddResult(SkillSourceLocator Source, bool Added);
+
+public sealed record SkillItem(string Id, string Description, SkillSourceLocator? Source,
+    string Version = "latest", string? NewVersion = null, IReadOnlyList<string>? Agents = null,
+    bool IsInstalled = false, bool HasUpdate = false)
+{
+    public string Name => CoreTools.FormatAsName(Id);
+    public string SourceName => Source?.Name ?? CoreTools.Translate("Local");
+    public string Provenance => $"{SourceName} · {Version}"
+        + (Agents is { Count: > 0 } ? $" · {string.Join(", ", Agents)}" : "");
+    public string DiscoverStatus => HasUpdate ? CoreTools.Translate("Update available")
+        : IsInstalled ? CoreTools.Translate("Installed") : "";
+    public bool HasDiscoverStatus => IsInstalled || HasUpdate;
+    public bool CanInstallFromDiscover => !IsInstalled && !HasUpdate;
+    public string AgentSummary => Agents is not { Count: > 0 } ? ""
+        : Agents.Count == 1 ? AgentName(Agents[0])
+        : $"{AgentName(Agents[0])} +{Agents.Count - 1}";
+    public string AgentNames => string.Join(", ", (Agents ?? []).Select(AgentName));
+    private static string AgentName(string id) => id switch
+    {
+        "claude-code" => "Claude Code",
+        "github-copilot" => "GitHub Copilot",
+        "codex" => "Codex",
+        "cursor" => "Cursor",
+        _ => CoreTools.FormatAsName(id),
+    };
+}
+
+/// <summary>
+/// Optional Agent Skills extension. Its domain objects and operations are independent of the
+/// package engine; the bundled library owns the agent folders and tracking files.
+/// </summary>
+public sealed class AgentSkillsService
+{
+    internal static readonly string SourcesListKey = Settings.ResolveKey(Settings.K.SkillsSources);
+    internal static readonly string TargetAgentsListKey = Settings.ResolveKey(Settings.K.SkillsTargetAgents);
+    internal const string LatestVersion = "latest";
+    internal const string UntrackedVersion = "local";
+    private static readonly SemaphoreSlim OperationGate = new(1, 1);
+    private readonly ISkillsBackend _backend;
+    private readonly ISkillsShClient _registry;
+    private readonly SkillSourceListings _listings;
+    private static readonly object RegistryGate = new();
+    private readonly ConcurrentDictionary<(string Source, string Skill), SkillSourceLocator> _registrySkills = new();
+    private readonly ConcurrentDictionary<string, (SkillUpdate Update, SkillSourceLocator Source)> _pendingUpdates =
+        new(StringComparer.OrdinalIgnoreCase);
+    private static int _registryGeneration;
+    private int _admittedGeneration = -1;
+    private IReadOnlyList<SkillItem>? _cachedUpdates;
+    private string? _updateInventory;
+    private DateTimeOffset _updatesCheckedAt;
+    private readonly TimeProvider _timeProvider;
+
+    public AgentSkillsService() : this(new AgentSkillsBackend(),
+        cacheDirectory: Path.Combine(CoreData.UniGetUICacheDirectory_Data, "AgentSkills", "Sources"))
+    { }
+
+    internal AgentSkillsService(ISkillsBackend backend, ISkillsShClient? registry = null, string? cacheDirectory = null,
+        TimeProvider? timeProvider = null)
+    {
+        _backend = backend;
+        _registry = registry ?? new SkillsShClient();
+        _listings = new(backend, cacheDirectory);
+        _timeProvider = timeProvider ?? TimeProvider.System;
+    }
+
+    public static IReadOnlyList<SkillSourceLocator> GetConfiguredSources() =>
+        (Settings.GetList<string>(SourcesListKey) ?? [])
+        .Select(SkillSourceLocator.Parse).OfType<SkillSourceLocator>()
+        .DistinctBy(source => source.Name, StringComparer.Ordinal).ToArray();
+
+    internal static SkillSourceLocator? GetConfiguredSource(string name) =>
+        GetConfiguredSources().FirstOrDefault(source => source.Name.Equals(name, StringComparison.Ordinal));
+
+    internal static SkillSourceLocator? FindConfiguredSource(SkillSourceLocator source) =>
+        GetConfiguredSources().Where(configured => configured.Covers(source))
+        .OrderByDescending(configured => configured.Url.AbsolutePath.Length).FirstOrDefault();
+
+    internal static bool IsAllowedSource(SkillSourceLocator source) => FindConfiguredSource(source) is not null;
+
+    internal SkillSourceLocator? GetInstallSource(SkillItem skill)
+    {
+        if (skill.Source is not { } source) return null;
+        if (FindConfiguredSource(source) is { } configured) return configured;
+        lock (RegistryGate)
+            return SkillsShDiscoveryEnabled && _admittedGeneration == _registryGeneration
+                && _registrySkills.TryGetValue((source.Name, skill.Id), out var discovered) ? discovered : null;
+    }
+
+    public bool SkillsShDiscoveryEnabled
+    {
+        get => Settings.Get(Settings.K.SkillsShDiscoveryEnabled);
+        set
+        {
+            lock (RegistryGate)
+            {
+                bool previous = SkillsShDiscoveryEnabled;
+                Settings.Set(Settings.K.SkillsShDiscoveryEnabled, value);
+                if (File.Exists(Path.Combine(CoreData.UniGetUIUserConfigurationDirectory,
+                    Settings.ResolveKey(Settings.K.SkillsShDiscoveryEnabled))) != value)
+                {
+                    Settings.Set(Settings.K.SkillsShDiscoveryEnabled, previous);
+                    throw new IOException(CoreTools.Translate("The skills.sh discovery preference could not be saved. Check your settings folder permissions and try again."));
+                }
+                ClearRegistryResults();
+            }
+        }
+    }
+
+    internal void ClearRegistryResults()
+    {
+        lock (RegistryGate)
+        {
+            _registryGeneration++;
+            _registrySkills.Clear();
+        }
+    }
+
+    internal static SkillSourceLocator? GetUpdateSource(SkillUpdate update, InstalledSkillInfo? installed) =>
+        installed is null or { SourceType: "well-known" }
+            ? SkillSourceLocator.Parse(update.Source) : SkillSourceLocator.ForInstalled(installed);
+
+    internal static IReadOnlyList<string>? GetTargetAgents() =>
+        Settings.GetList<string>(TargetAgentsListKey) is { Count: > 0 } agents ? agents : null;
+
+    public static IReadOnlyList<string> TargetAgents
+    {
+        get => GetTargetAgents() ?? [];
+        set => Settings.SetList(TargetAgentsListKey, value.Distinct().ToList());
+    }
+
+    public IReadOnlyList<AgentInfo> GetSupportedAgents() => _backend.GetAgents();
+    public Task<SkillPreview> PreviewAsync(SkillItem skill, CancellationToken token = default)
+    {
+        var source = GetInstallSource(skill) ?? throw NotAllowed(skill.SourceName);
+        return Task.Run(() => _backend.PreviewSkill(source.InstallSource, skill.Id, token), token);
+    }
+
+    public bool HasNotionSources => GetConfiguredSources().Any(source => source.Kind is SkillSourceKind.Notion);
+    public Task<NotionStatus> GetNotionStatusAsync() =>
+        Task.Run(() => _backend.GetNotionStatus(CancellationToken.None));
+    public Task<NotionSignIn> BeginNotionSignInAsync(CancellationToken token) =>
+        Task.Run(() => _backend.BeginNotionSignIn(token), token);
+    public async Task CompleteNotionSignInAsync(CancellationToken token)
+    {
+        await Task.Run(() => _backend.CompleteNotionSignIn(token), token);
+        RefreshNotionSources();
+    }
+    public async Task SignOutOfNotionAsync()
+    {
+        await Task.Run(() => _backend.SignOutOfNotion(CancellationToken.None));
+        RefreshNotionSources();
+    }
+    public void RefreshNotionSources()
+    {
+        NotionCliTool.Forget();
+        foreach (var source in GetConfiguredSources().Where(source => source.Kind is SkillSourceKind.Notion))
+            _listings.Forget(source);
+    }
+
+    internal static string ShortHash(string? hash)
+    {
+        if (string.IsNullOrWhiteSpace(hash)) return LatestVersion;
+        if (hash.StartsWith("sha256:", StringComparison.OrdinalIgnoreCase)) hash = hash[7..];
+        return hash.Length > 7 ? hash[..7] : hash;
+    }
+
+    /// <summary>
+    /// Finds skills in the configured sources and, when its discovery is on, on skills.sh. With
+    /// <paramref name="filterSources"/> off, every skill of the configured sources is returned and
+    /// only the skills.sh search uses the query. <paramref name="refreshSources"/> fetches the sources
+    /// again instead of reusing saved metadata. Cached metadata never supplies installation files.
+    /// </summary>
+    public IReadOnlyList<SkillItem> Search(string query, IProgress<string>? progress = null,
+        CancellationToken cancellationToken = default, bool filterSources = true, bool refreshSources = false,
+        SkillDiscoveryScope scope = SkillDiscoveryScope.All)
+    {
+        Dictionary<(string, string), SkillItem> found = [];
+        int generation;
+        Task<IReadOnlyList<SkillsShResult>>? registrySearch;
+        lock (RegistryGate)
+        {
+            generation = _registryGeneration;
+            registrySearch = scope != SkillDiscoveryScope.Sources && SkillsShDiscoveryEnabled && query.Trim().Length >= 2
+                ? Task.Run(() => _registry.Search(query), cancellationToken) : null;
+        }
+        int failedSources = 0;
+        var sources = scope == SkillDiscoveryScope.PublicCatalog ? [] : GetConfiguredSources();
+        foreach (var source in sources)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            try
+            {
+                var skills = _listings.Get(source, progress, cancellationToken, refreshSources);
+                foreach (var skill in skills.Where(skill => !filterSources
+                    || skill.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
+                    || skill.Description.Contains(query, StringComparison.OrdinalIgnoreCase)
+                    || (skill.PluginName?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)))
+                    found.TryAdd((source.Name, skill.Name), new(skill.Name, skill.Description, source));
+            }
+            catch (Exception ex) when (ex is not OperationCanceledException)
+            {
+                failedSources++;
+                progress?.Report(CoreTools.Translate("Could not search {0}: {1}", source.Name, ex.Message));
+                Logger.Warn(ex);
+            }
+        }
+        if (scope == SkillDiscoveryScope.Sources && failedSources > 0)
+            throw new SkillsException(CoreTools.Translate("Could not refresh {0} sources. Review activity and try again.", failedSources));
+        if (registrySearch is not null)
+        {
+            try
+            {
+                var discovered = registrySearch.WaitAsync(cancellationToken).GetAwaiter().GetResult();
+                lock (RegistryGate)
+                {
+                    if (SkillsShDiscoveryEnabled && generation == _registryGeneration)
+                    {
+                        if (_admittedGeneration != generation) _registrySkills.Clear();
+                        _admittedGeneration = generation;
+                        foreach (var skill in discovered)
+                        {
+                            _registrySkills[(skill.Source.Name, skill.Name)] = skill.Source;
+                            found.TryAdd((skill.Source.Name, skill.Name), new(skill.Name,
+                                CoreTools.Translate("Discovered on skills.sh. Installs from the repository or website shown as its source. Review the skill before installing it."),
+                                skill.Source));
+                        }
+                    }
+                }
+            }
+            catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+                if (scope == SkillDiscoveryScope.PublicCatalog) throw;
+                progress?.Report(CoreTools.Translate("Could not search skills.sh: {0}", ex.Message));
+            }
+        }
+        return [.. found.Values];
+    }
+
+    public IReadOnlyList<SkillItem> ListInstalled(CancellationToken token = default) =>
+        _backend.GetInstalledSkills(token).Select(skill => new SkillItem(skill.Name, skill.Description,
+            SkillSourceLocator.ForInstalled(skill), skill.IsTracked ? ShortHash(skill.Hash) : UntrackedVersion,
+            Agents: skill.Agents)).ToArray();
+
+    public IReadOnlyList<SkillItem> CheckUpdates(IProgress<string>? progress = null, CancellationToken token = default, bool refresh = true)
+    {
+        var installed = _backend.GetInstalledSkills(token);
+        token.ThrowIfCancellationRequested();
+        string inventory = string.Join('\n', installed.Select(skill =>
+            string.Join('\0', skill.Name, skill.Source, skill.SourceType, skill.SourceUrl, skill.SourceBaseUrl,
+                skill.Ref, skill.SkillPath, skill.PinnedRef, skill.Hash, skill.Path,
+                skill.UpdatedAt?.ToString("O"), string.Join(',', skill.Agents.Order(StringComparer.Ordinal)))).Order(StringComparer.Ordinal))
+            + "\nSources:\n" + string.Join('\n', GetConfiguredSources().Select(source => source.InstallSource).Order(StringComparer.Ordinal));
+        if (!refresh && _cachedUpdates is not null && _updateInventory == inventory
+            && _timeProvider.GetUtcNow() - _updatesCheckedAt < TimeSpan.FromMinutes(15)) return _cachedUpdates;
+        string[] eligible = installed.Where(skill =>
+            SkillSourceLocator.ForInstalled(skill) is { } source && IsAllowedSource(source))
+            .Select(skill => skill.Name).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
+        _pendingUpdates.Clear();
+        if (eligible.Length == 0)
+        {
+            _cachedUpdates = [];
+            _updateInventory = inventory;
+            _updatesCheckedAt = _timeProvider.GetUtcNow();
+            return [];
+        }
+        var check = _backend.CheckForUpdates(eligible, progress, token);
+        List<SkillItem> updates = [];
+        foreach (var update in check.Updates)
+        {
+            var skill = installed.FirstOrDefault(skill => skill.Name.Equals(update.Name, StringComparison.OrdinalIgnoreCase));
+            var source = GetUpdateSource(update, skill);
+            if (source is null || !IsAllowedSource(source)) continue;
+            _pendingUpdates[update.Name] = (update, source);
+            updates.Add(new(update.Name, skill?.Description ?? "", source, ShortHash(update.CurrentHash),
+                ShortHash(update.LatestHash), skill?.Agents));
+        }
+        foreach (var skipped in check.Unchecked) progress?.Report($"{skipped.Name}: {skipped.Reason}");
+        token.ThrowIfCancellationRequested();
+        _cachedUpdates = check.Unchecked.Count == 0 ? updates : null;
+        _updateInventory = inventory;
+        _updatesCheckedAt = _timeProvider.GetUtcNow();
+        return updates;
+    }
+
+    public async Task PerformAsync(SkillItem skill, SkillAction action, IProgress<string>? progress = null,
+        CancellationToken cancellationToken = default, IReadOnlyList<string>? targetAgents = null)
+    {
+        await OperationGate.WaitAsync(cancellationToken);
+        try
+        {
+            _cachedUpdates = null;
+            await Task.Run(() =>
+            {
+                switch (action)
+                {
+                    case SkillAction.Install:
+                        var source = GetInstallSource(skill) ?? throw NotAllowed(skill.SourceName);
+                        var install = _backend.Install(source.InstallSource, skill.Id, targetAgents ?? GetTargetAgents(), progress, cancellationToken);
+                        var installedOutcome = install.Skills.FirstOrDefault(s => s.Name.Equals(skill.Id, StringComparison.OrdinalIgnoreCase));
+                        RequireSuccess(installedOutcome?.Status, installedOutcome?.Error, skill.Id);
+                        RememberInstalledSource(source);
+                        break;
+                    case SkillAction.Update:
+                        SkillUpdate? update = null;
+                        if (_pendingUpdates.TryRemove(skill.Id, out var pending) && IsAllowedSource(pending.Source))
+                            update = pending.Update;
+                        if (update is null)
+                        {
+                            var installed = _backend.GetInstalledSkills(cancellationToken)
+                                .FirstOrDefault(s => s.Name.Equals(skill.Id, StringComparison.OrdinalIgnoreCase));
+                            if (installed is null || SkillSourceLocator.ForInstalled(installed) is not { } original
+                                || !IsAllowedSource(original)) throw NotAllowed(skill.SourceName);
+                            var check = _backend.CheckForUpdates([skill.Id], progress, cancellationToken);
+                            if (check.Unchecked.FirstOrDefault(s => s.Name.Equals(skill.Id, StringComparison.OrdinalIgnoreCase)) is { } skipped)
+                                throw new SkillsException(skipped.Reason);
+                            update = check.Updates.FirstOrDefault(s => s.Name.Equals(skill.Id, StringComparison.OrdinalIgnoreCase));
+                            if (update is null) return;
+                            if (GetUpdateSource(update, installed) is not { } actual || !IsAllowedSource(actual))
+                                throw NotAllowed(skill.SourceName);
+                        }
+                        var result = _backend.Update([update], progress, cancellationToken);
+                        var updatedOutcome = result.Skills.FirstOrDefault(s => s.Name.Equals(skill.Id, StringComparison.OrdinalIgnoreCase));
+                        RequireSuccess(updatedOutcome?.Status, updatedOutcome?.Error, skill.Id);
+                        break;
+                    case SkillAction.Remove:
+                        var removed = _backend.Remove(skill.Id, progress, cancellationToken).Skills.FirstOrDefault();
+                        if (removed?.Status != SkillOperationStatus.NotFound) RequireSuccess(removed?.Status, removed?.Error, skill.Id);
+                        break;
+                    default: throw new ArgumentOutOfRangeException(nameof(action));
+                }
+            }, cancellationToken);
+        }
+        finally { OperationGate.Release(); }
+    }
+
+    private static void RequireSuccess(SkillOperationStatus? status, string? error, string skill)
+    {
+        if (status is not SkillOperationStatus.Succeeded)
+            throw new SkillsException(error ?? CoreTools.Translate("{0} could not be changed", skill));
+    }
+
+    private static SkillsException NotAllowed(string source) => new(CoreTools.Translate(
+        "{0} is not one of your Agent Skills sources. Add this source first, then try again.", source));
+
+    private static void RememberInstalledSource(SkillSourceLocator source)
+    {
+        if (FindConfiguredSource(source) is not null) return;
+        Settings.AddToList(SourcesListKey, source.InstallSource);
+        if (FindConfiguredSource(source) is null)
+            throw new SkillsException(CoreTools.Translate("The skill was installed, but its source {0} could not be saved. Add it in Agent Skills settings to receive updates.", source.Name));
+    }
+
+    /// <summary>
+    /// Adds a source, reading its skills first so a source that offers none is refused. A source that
+    /// is already added is not read again; the result tells which source the address resolved to and
+    /// whether it was new.
+    /// </summary>
+    public async Task<SourceAddResult> AddSourceAsync(string address, IProgress<string>? progress = null, CancellationToken token = default)
+    {
+        token.ThrowIfCancellationRequested();
+        var source = SkillSourceLocator.ParseUserInput(address) ?? throw new ArgumentException(CoreTools.Translate(
+            "Enter a GitHub repository (owner/repo), a git repository URL, an HTTPS skills index, or a Notion database."));
+        if (FindConfiguredSource(source) is { } existing) return new(existing, false);
+        try
+        {
+            var skills = await Task.Run(() => _backend.GetAvailableSkills(source.InstallSource, progress, token), token);
+            token.ThrowIfCancellationRequested();
+            if (skills.Count == 0) throw new SkillsException(CoreTools.Translate("This source does not offer any skills."));
+            _listings.Store(source, skills);
+        }
+        catch (SkillsException ex) when (source.Kind is SkillSourceKind.Notion
+            && ex.Failure is SkillsFailure.NotionCliMissing or SkillsFailure.NotionSignedOut)
+        {
+            progress?.Report(CoreTools.Translate("Sign in to Notion in the Agent Skills settings to see the skills of this source."));
+        }
+        token.ThrowIfCancellationRequested();
+        RememberInstalledSource(source);
+        return new(FindConfiguredSource(source) ?? source, true);
+    }
+
+    /// <summary>The skills one configured source offers.</summary>
+    public IReadOnlyList<SkillItem> ListSource(SkillSourceLocator source, IProgress<string>? progress = null,
+        CancellationToken token = default) =>
+        _listings.Get(source, progress, token).Select(skill => new SkillItem(skill.Name, skill.Description, source)).ToArray();
+
+    public void RemoveSource(SkillSourceLocator source)
+    {
+        Settings.SetList(SourcesListKey, (Settings.GetList<string>(SourcesListKey) ?? [])
+            .Where(entry => !(SkillSourceLocator.Parse(entry)?.Name ?? entry).Equals(source.Name, StringComparison.Ordinal)).ToList());
+        ClearRegistryResults();
+        _listings.Forget(source);
+    }
+}
diff --git a/src/UniGetUI.Extensions.AgentSkills/ClaudePluginService.cs b/src/UniGetUI.Extensions.AgentSkills/ClaudePluginService.cs
new file mode 100644
index 0000000..9380006
--- /dev/null
+++ b/src/UniGetUI.Extensions.AgentSkills/ClaudePluginService.cs
@@ -0,0 +1,230 @@
+using System.Diagnostics;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using System.Text.Json.Serialization.Metadata;
+using UniGetUI.Core.Tools;
+
+namespace UniGetUI.Extensions.AgentSkills;
+
+/// <summary>Claude owns plugin installation, settings, dependencies and trust policy. No plugin files are copied by UniGetUI.</summary>
+public sealed class ClaudePluginService : IAgentPluginService
+{
+    public string Name => "Claude Code";
+    public string Guidance => CoreTools.Translate("Native Claude Code plugins for your user account, shared by the Claude Code CLI and the Code tab in Claude Desktop. Uses claude, or the copy bundled with Claude Desktop. Cowork and organization plugins are managed in the Claude app. These are separate from cross-agent skills.");
+    public string RemovalWarning => CoreTools.Translate("Remove this marketplace from your Claude user settings? If this is its last declaration, Claude also uninstalls its plugins and deletes their saved data, options and secrets. Refresh the marketplace instead to keep them.");
+    public string RestartNotice => CoreTools.Translate("Restart active Claude Code sessions, including the Code tab in Claude Desktop, to apply plugin changes.");
+    public bool SupportsUpdate => true;
+    public bool SupportsToggle => true;
+    public bool SupportsScopedBrowse => true;
+    // Claude has no per-marketplace listing, so marketplaces browsed together share one --available read.
+    private static readonly TimeSpan AvailableCatalogLifetime = TimeSpan.FromSeconds(30);
+    private readonly IAgentPluginRunner _runner;
+    private readonly Lock _availableLock = new();
+    private Task<ClaudePluginList>? _available;
+    private long _availableStarted;
+    public ClaudePluginService() : this(new AgentPluginProcessRunner()) { }
+    internal ClaudePluginService(IAgentPluginRunner runner) => _runner = runner;
+
+    public async Task<AgentPluginCatalog> GetCatalogAsync(CancellationToken token = default)
+    {
+        string plugins = await _runner.RunAsync(["plugin", "list", "--json", "--available"], token);
+        string marketplaces = await _runner.RunAsync(["plugin", "marketplace", "list", "--json"], token);
+        return ParseCatalog(plugins, marketplaces);
+    }
+
+    public async Task<AgentPluginCatalog> GetInstalledCatalogAsync(CancellationToken token = default)
+    {
+        string plugins = await _runner.RunAsync(["plugin", "list", "--json"], token);
+        string marketplaces = await _runner.RunAsync(["plugin", "marketplace", "list", "--json"], token);
+        return ParseInstalledCatalog(plugins, marketplaces);
+    }
+
+    internal static AgentPluginCatalog ParseInstalledCatalog(string plugins, string marketplaces)
+    {
+        // Without --available, Claude prints a bare array of installed plugins rather than { installed, available }.
+        var installedPlugins = plugins.TrimStart().StartsWith('[')
+            ? Deserialize(plugins, ClaudePluginJsonContext.Default.ClaudeInstalledPluginArray)
+            : Deserialize(plugins, ClaudePluginJsonContext.Default.ClaudePluginList)?.Installed;
+        var markets = Deserialize(marketplaces, ClaudePluginJsonContext.Default.ClaudeMarketplaceEntryArray)
+            ?? throw new JsonException(CoreTools.Translate("Claude returned an empty marketplace inventory."));
+        if (installedPlugins is null)
+            throw new JsonException(CoreTools.Translate("Claude returned an unsupported plugin inventory. Update Claude Code and try again."));
+        var installed = installedPlugins.Where(item => item.Scope == "user").Select(item =>
+        {
+            string id = RequirePluginId(item.Id ?? "");
+            string description = item.Errors is { Length: > 0 } ? string.Join(Environment.NewLine, item.Errors) : "";
+            return new AgentPluginItem(id, description, item.Version ?? "", true, item.Enabled);
+        }).ToArray();
+        return new(installed,
+            markets.Select(item => new AgentPluginMarketplace(RequireValue(item.Name ?? ""), item.Url ?? item.Source ?? ""))
+                .OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase).ToArray());
+    }
+
+    public async Task<AgentPluginCatalog> GetMarketplaceCatalogAsync(string marketplace, CancellationToken token = default)
+    {
+        string name = RequireValue(marketplace);
+        ClaudePluginList catalog = await GetAvailableAsync().WaitAsync(token);
+        string suffix = "@" + name;
+        Dictionary<string, AgentPluginItem> items = new(StringComparer.Ordinal);
+        foreach (var item in catalog.Available!.Where(item => item.PluginId?.EndsWith(suffix, StringComparison.Ordinal) == true))
+        {
+            string id = RequirePluginId(item.PluginId!);
+            items[id] = new(id, item.Description ?? "", item.Version ?? "", false, false);
+        }
+        // Claude leaves installed plugins out of the available list; keep them so an uninstall leaves an installable row.
+        foreach (var item in catalog.Installed!.Where(item => item.Scope == "user" && item.Id?.EndsWith(suffix, StringComparison.Ordinal) == true))
+        {
+            string id = RequirePluginId(item.Id!);
+            items.TryAdd(id, new(id, "", item.Version ?? "", false, false));
+        }
+        return new(items.Values.OrderBy(item => item.Id, StringComparer.OrdinalIgnoreCase).ToArray(), []);
+    }
+
+    // The shared read is not tied to one caller's token (the runner bounds it), so one cancelled browse cannot fail another.
+    private Task<ClaudePluginList> GetAvailableAsync()
+    {
+        lock (_availableLock)
+        {
+            if (_available is null || _available.IsFaulted || _available.IsCanceled
+                || Stopwatch.GetElapsedTime(_availableStarted) > AvailableCatalogLifetime)
+            {
+                _available = ReadAvailableAsync(CancellationToken.None);
+                _availableStarted = Stopwatch.GetTimestamp();
+            }
+            return _available;
+        }
+    }
+
+    private async Task<ClaudePluginList> ReadAvailableAsync(CancellationToken token)
+    {
+        string plugins = await _runner.RunAsync(["plugin", "list", "--json", "--available"], token);
+        var catalog = Deserialize(plugins, ClaudePluginJsonContext.Default.ClaudePluginList)
+            ?? throw new JsonException(CoreTools.Translate("Claude returned an empty plugin inventory."));
+        if (catalog.Installed is null || catalog.Available is null)
+            throw new JsonException(CoreTools.Translate("Claude returned an unsupported plugin inventory. Update Claude Code and try again."));
+        return catalog;
+    }
+
+    private async Task<string> MutateAsync(IReadOnlyList<string> args, CancellationToken token)
+    {
+        try { return await _runner.RunAsync(args, token); }
+        finally
+        {
+            lock (_availableLock) _available = null;
+        }
+    }
+
+    internal static AgentPluginCatalog ParseCatalog(string plugins, string marketplaces)
+    {
+        var catalog = Deserialize(plugins, ClaudePluginJsonContext.Default.ClaudePluginList)
+            ?? throw new JsonException(CoreTools.Translate("Claude returned an empty plugin inventory."));
+        var markets = Deserialize(marketplaces, ClaudePluginJsonContext.Default.ClaudeMarketplaceEntryArray)
+            ?? throw new JsonException(CoreTools.Translate("Claude returned an empty marketplace inventory."));
+        if (catalog.Installed is null || catalog.Available is null)
+            throw new JsonException(CoreTools.Translate("Claude returned an unsupported plugin inventory. Update Claude Code and try again."));
+        Dictionary<string, AgentPluginItem> items = new(StringComparer.Ordinal);
+        foreach (var item in catalog.Available)
+        {
+            string id = RequirePluginId(item.PluginId ?? "");
+            items[id] = new(id, item.Description ?? "", item.Version ?? "", false, false);
+        }
+        foreach (var item in catalog.Installed.Where(item => item.Scope == "user"))
+        {
+            string id = RequirePluginId(item.Id ?? "");
+            string description = items.GetValueOrDefault(id)?.Description ?? "";
+            if (item.Errors is { Length: > 0 })
+                description = string.Join(Environment.NewLine, new[] { description }.Concat(item.Errors).Where(line => line.Length > 0));
+            items[id] = new(id, description, item.Version ?? "", true, item.Enabled);
+        }
+        return new(items.Values.OrderBy(item => item.Id, StringComparer.OrdinalIgnoreCase).ToArray(),
+            markets.Select(item => new AgentPluginMarketplace(RequireValue(item.Name ?? ""), item.Url ?? item.Source ?? ""))
+                .OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase).ToArray());
+    }
+
+    public Task<string> AddMarketplaceAsync(string input, CancellationToken token = default)
+    {
+        string source = StripCommand(input, "/plugin marketplace add ");
+        return MutateAsync(["plugin", "marketplace", "add", RequireValue(source), "--scope", "user"], token);
+    }
+
+    public Task<string> UpdateMarketplaceAsync(string name, CancellationToken token = default) =>
+        MutateAsync(["plugin", "marketplace", "update", RequireValue(name)], token);
+
+    public Task<string> RemoveMarketplaceAsync(string name, CancellationToken token = default) =>
+        MutateAsync(["plugin", "marketplace", "remove", RequireValue(name), "--scope", "user"], token);
+
+    public Task<string> PerformAsync(string input, AgentPluginAction action, CancellationToken token = default)
+    {
+        string id = RequirePluginId(StripCommand(input, "/plugin install "));
+        string command = action switch
+        {
+            AgentPluginAction.Install => "install",
+            AgentPluginAction.Update => "update",
+            AgentPluginAction.Enable => "enable",
+            AgentPluginAction.Disable => "disable",
+            AgentPluginAction.Uninstall => "uninstall",
+            _ => throw new ArgumentOutOfRangeException(nameof(action)),
+        };
+        // Never accept marketplace-declared shell commands automatically (--yes / --accept-command).
+        return MutateAsync(["plugin", command, id, "--scope", "user"], token);
+    }
+
+    private static string StripCommand(string input, string prefix) =>
+        input.Trim().StartsWith(prefix, StringComparison.Ordinal)
+            ? input.Trim()[prefix.Length..].Trim() : input.Trim();
+
+    private static T? Deserialize<T>(string json, JsonTypeInfo<T> typeInfo) =>
+        JsonSerializer.Deserialize(json, typeInfo);
+
+    private static string RequireValue(string value)
+    {
+        if (string.IsNullOrWhiteSpace(value) || value.StartsWith('-') || value.Any(char.IsControl))
+            throw new ArgumentException(CoreTools.Translate("Enter a valid Claude marketplace or plugin identifier."));
+        return value;
+    }
+
+    private static string RequirePluginId(string value)
+    {
+        RequireValue(value);
+        string[] parts = value.Split('@');
+        if (parts.Length != 2 || parts.Any(part => part.Length == 0
+                || part.Any(character => !char.IsAsciiLetterOrDigit(character) && character is not '-' and not '_' and not '.')))
+            throw new ArgumentException(CoreTools.Translate("Enter a plugin identifier in name@marketplace format."));
+        return value;
+    }
+}
+
+internal sealed class ClaudePluginList
+{
+    public ClaudeInstalledPlugin[]? Installed { get; set; }
+    public ClaudeAvailablePlugin[]? Available { get; set; }
+}
+
+internal sealed class ClaudeInstalledPlugin
+{
+    public string? Id { get; set; }
+    public string? Version { get; set; }
+    public string? Scope { get; set; }
+    public bool Enabled { get; set; }
+    public string[]? Errors { get; set; }
+}
+
+internal sealed class ClaudeAvailablePlugin
+{
+    public string? PluginId { get; set; }
+    public string? Description { get; set; }
+    public string? Version { get; set; }
+}
+
+internal sealed class ClaudeMarketplaceEntry
+{
+    public string? Name { get; set; }
+    public string? Source { get; set; }
+    public string? Url { get; set; }
+}
+
+[JsonSourceGenerationOptions(PropertyNamingPolicy = JsonKnownNamingPolicy.CamelCase)]
+[JsonSerializable(typeof(ClaudePluginList))]
+[JsonSerializable(typeof(ClaudeInstalledPlugin[]))]
+[JsonSerializable(typeof(ClaudeMarketplaceEntry[]))]
+internal sealed partial class ClaudePluginJsonContext : JsonSerializerContext;
diff --git a/src/UniGetUI.Extensions.AgentSkills/CodexAppServerClient.cs b/src/UniGetUI.Extensions.AgentSkills/CodexAppServerClient.cs
new file mode 100644
index 0000000..14e3a2e
--- /dev/null
+++ b/src/UniGetUI.Extensions.AgentSkills/CodexAppServerClient.cs
@@ -0,0 +1,210 @@
+using System.Diagnostics;
+using System.Text;
+using System.Text.Json;
+using UniGetUI.Core.Data;
+using UniGetUI.Core.Logging;
+using UniGetUI.Core.Tools;
+
+namespace UniGetUI.Extensions.AgentSkills;
+
+internal interface ICodexConfigWriter
+{
+    Task<string> SetPluginEnabledAsync(string pluginId, bool enabled, CancellationToken token);
+}
+
+/// <summary>
+/// The Codex CLI has no enable/disable command. The Codex app, its TUI and IDE extensions all toggle plugins through
+/// the app-server config API instead, so the same validated, comment-preserving write is used here. The server is
+/// started for a single request and stopped again.
+/// </summary>
+internal sealed class CodexAppServerConfigWriter : ICodexConfigWriter
+{
+    private readonly Func<string?> _findExecutable;
+    private readonly IReadOnlyList<string> _arguments;
+    private readonly TimeSpan _timeout;
+
+    public CodexAppServerConfigWriter() : this(() => AgentHostLocator.Find("codex"), ["app-server"], TimeSpan.FromMinutes(1)) { }
+    internal CodexAppServerConfigWriter(Func<string?> findExecutable, IReadOnlyList<string> arguments, TimeSpan timeout)
+    {
+        _findExecutable = findExecutable;
+        _arguments = arguments;
+        _timeout = timeout;
+    }
+
+    public async Task<string> SetPluginEnabledAsync(string pluginId, bool enabled, CancellationToken token)
+    {
+        token.ThrowIfCancellationRequested();
+        string id = AgentPluginInput.PluginId(pluginId);
+        string executable = _findExecutable() ?? throw new InvalidOperationException(AgentPluginProcessRunner.NotFoundMessage("Codex"));
+        var info = new ProcessStartInfo(executable)
+        {
+            WorkingDirectory = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
+            UseShellExecute = false,
+            CreateNoWindow = true,
+            RedirectStandardInput = true,
+            RedirectStandardOutput = true,
+            RedirectStandardError = true,
+            StandardInputEncoding = new UTF8Encoding(false),
+            StandardOutputEncoding = Encoding.UTF8,
+            StandardErrorEncoding = Encoding.UTF8,
+        };
+        foreach (string argument in _arguments) info.ArgumentList.Add(argument);
+        info.Environment["NO_COLOR"] = "1";
+        using var limit = CancellationTokenSource.CreateLinkedTokenSource(token);
+        limit.CancelAfter(_timeout);
+        using var process = new Process { StartInfo = info };
+        process.Start();
+        Task<string> error = process.StandardError.ReadToEndAsync(CancellationToken.None);
+        try
+        {
+            string result = await ExchangeAsync(process.StandardInput, process.StandardOutput, id, enabled, limit.Token,
+                () => error.Wait(TimeSpan.FromSeconds(2)) ? error.Result : "");
+            process.StandardInput.Close();
+            using var exit = new CancellationTokenSource(TimeSpan.FromSeconds(5));
+            try { await process.WaitForExitAsync(exit.Token); }
+            catch (OperationCanceledException) { Kill(process); }
+            return result;
+        }
+        catch (OperationCanceledException)
+        {
+            Kill(process);
+            if (token.IsCancellationRequested) throw;
+            throw new TimeoutException(CoreTools.Translate("The {0} plugin command timed out. Check the agent and try again.", "Codex"));
+        }
+        catch
+        {
+            Kill(process);
+            throw;
+        }
+    }
+
+    internal static async Task<string> ExchangeAsync(TextWriter input, TextReader output, string pluginId, bool enabled,
+        CancellationToken token, Func<string>? errorOutput = null)
+    {
+        await SendAsync(input, Initialize(), token);
+        await ReadResultAsync(output, 1, token, errorOutput);
+        await SendAsync(input, Notification("initialized"), token);
+        await SendAsync(input, WritePluginEnabled(pluginId, enabled), token);
+        using JsonDocument result = await ReadResultAsync(output, 2, token, errorOutput);
+        JsonElement root = result.RootElement;
+        if (root.ValueKind != JsonValueKind.Object)
+            throw new InvalidDataException(CoreTools.Translate("Codex returned an unexpected response."));
+        string status = root.TryGetProperty("status", out JsonElement value) && value.ValueKind == JsonValueKind.String
+            ? value.GetString() ?? "" : "";
+        string file = root.TryGetProperty("filePath", out JsonElement path) && path.ValueKind == JsonValueKind.String
+            ? path.GetString() ?? "" : "";
+        return status switch
+        {
+            "ok" => enabled
+                ? CoreTools.Translate("Enabled {0} in {1}", pluginId, file)
+                : CoreTools.Translate("Disabled {0} in {1}", pluginId, file),
+            "okOverridden" => throw new InvalidOperationException(CoreTools.Translate(
+                "Codex saved the change, but a managed or higher-priority configuration overrides it.")),
+            _ => throw new InvalidDataException(CoreTools.Translate("Codex returned an unexpected response.")),
+        };
+    }
+
+    /// <summary>Plugin ids are only letters, digits, '-', '_', '.' and '@', so only a '.' needs a quoted key segment.</summary>
+    internal static string PluginKeyPath(string pluginId) =>
+        "plugins." + (pluginId.Contains('.') ? "\"" + pluginId + "\"" : pluginId);
+
+    private static string Initialize() => Json(writer =>
+    {
+        writer.WriteNumber("id", 1);
+        writer.WriteString("method", "initialize");
+        writer.WriteStartObject("params");
+        writer.WriteStartObject("clientInfo");
+        writer.WriteString("name", "unigetui");
+        writer.WriteString("title", "UniGetUI");
+        writer.WriteString("version", CoreData.VersionName);
+        writer.WriteEndObject();
+        writer.WriteEndObject();
+    });
+
+    private static string Notification(string method) => Json(writer => writer.WriteString("method", method));
+
+    private static string WritePluginEnabled(string pluginId, bool enabled) => Json(writer =>
+    {
+        writer.WriteNumber("id", 2);
+        writer.WriteString("method", "config/value/write");
+        writer.WriteStartObject("params");
+        writer.WriteString("keyPath", PluginKeyPath(pluginId));
+        writer.WriteStartObject("value");
+        writer.WriteBoolean("enabled", enabled);
+        writer.WriteEndObject();
+        writer.WriteString("mergeStrategy", "upsert");
+        writer.WriteEndObject();
+    });
+
+    private static string Json(Action<Utf8JsonWriter> body)
+    {
+        using var stream = new MemoryStream();
+        using (var writer = new Utf8JsonWriter(stream))
+        {
+            writer.WriteStartObject();
+            body(writer);
+            writer.WriteEndObject();
+        }
+        return Encoding.UTF8.GetString(stream.ToArray());
+    }
+
+    private static async Task SendAsync(TextWriter input, string message, CancellationToken token)
+    {
+        await input.WriteLineAsync(message.AsMemory(), token);
+        await input.FlushAsync(token);
+    }
+
+    /// <summary>Notifications and server requests can arrive first; skip everything but the response to <paramref name="id"/>.</summary>
+    private static async Task<JsonDocument> ReadResultAsync(TextReader output, int id, CancellationToken token, Func<string>? errorOutput)
+    {
+        while (true)
+        {
+            string? line = await output.ReadLineAsync(token).AsTask().WaitAsync(token);
+            if (line is null)
+            {
+                string detail = errorOutput?.Invoke().Trim() ?? "";
+                throw new InvalidOperationException(CoreTools.Translate("Codex app-server stopped before replying. {0}", detail).Trim());
+            }
+            if (string.IsNullOrWhiteSpace(line)) continue;
+            JsonDocument message;
+            try
+            {
+                message = JsonDocument.Parse(line);
+            }
+            catch (JsonException)
+            {
+                Logger.Debug("Ignoring a non-JSON line from the Codex app-server");
+                continue;
+            }
+            JsonElement root = message.RootElement;
+            if (root.ValueKind != JsonValueKind.Object || root.TryGetProperty("method", out _)
+                || !root.TryGetProperty("id", out JsonElement responseId)
+                || responseId.ValueKind != JsonValueKind.Number || !responseId.TryGetInt32(out int value) || value != id)
+            {
+                message.Dispose();
+                continue;
+            }
+            using (message)
+            {
+                if (root.TryGetProperty("error", out JsonElement error))
+                {
+                    string text = error.ValueKind == JsonValueKind.Object && error.TryGetProperty("message", out JsonElement detail)
+                        && detail.ValueKind == JsonValueKind.String ? detail.GetString() ?? "" : error.GetRawText();
+                    throw new InvalidOperationException(CoreTools.Translate("Codex rejected the plugin change: {0}", text));
+                }
+                if (!root.TryGetProperty("result", out JsonElement result))
+                    throw new InvalidDataException(CoreTools.Translate("Codex returned an unexpected response."));
+                return JsonDocument.Parse(result.GetRawText());
+            }
+        }
+    }
+
+    private static void Kill(Process process)
+    {
+        try
+        {
+            if (!process.HasExited) process.Kill(entireProcessTree: true);
+        }
+        catch (InvalidOperationException) { }
+    }
+}
diff --git a/src/UniGetUI.Extensions.AgentSkills/CodexPluginService.cs b/src/UniGetUI.Extensions.AgentSkills/CodexPluginService.cs
new file mode 100644
index 0000000..ef2c707
--- /dev/null
+++ b/src/UniGetUI.Extensions.AgentSkills/CodexPluginService.cs
@@ -0,0 +1,189 @@
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using System.Text.Json.Serialization.Metadata;
+using UniGetUI.Core.Tools;
+
+namespace UniGetUI.Extensions.AgentSkills;
+
+public sealed class CodexPluginService : IAgentPluginService
+{
+    /// <summary>Marketplaces the Codex app provisions itself. Codex restores their plugins, so only toggling is offered.</summary>
+    private static readonly HashSet<string> AppMarketplaces = new(StringComparer.Ordinal)
+    {
+        "openai-bundled", "openai-bundled-alpha", "openai-primary-runtime",
+    };
+    private readonly IAgentPluginRunner _runner;
+    private readonly ICodexConfigWriter _config;
+    public string Name => "Codex";
+    public string CacheIdentity => $"{Name}:{Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(Environment.GetEnvironmentVariable("CODEX_HOME") ?? "")))}";
+    public string Guidance => CoreTools.Translate("Native Codex plugins, shared by the Codex CLI, the Codex app and the IDE extension. Uses codex, or the copy bundled with the Codex app. Codex owns configuration, authentication and policy.");
+    public string RemovalWarning => CoreTools.Translate("Remove this marketplace from your Codex configuration? Its plugins may stop loading. Refresh instead to keep the source.");
+    public string RestartNotice => CoreTools.Translate("Restart active Codex sessions and the Codex app after plugin changes. Refresh the marketplace to fetch source updates.");
+    public bool SupportsUpdate => false;
+    public bool SupportsToggle => true;
+    public bool SupportsScopedBrowse => true;
+
+    public CodexPluginService() : this(new AgentPluginProcessRunner(
+        () => AgentPluginProcessRunner.FindNativeExecutable("codex"), TimeSpan.FromMinutes(3), "Codex"),
+        new CodexAppServerConfigWriter())
+    { }
+    internal CodexPluginService(IAgentPluginRunner runner, ICodexConfigWriter? config = null)
+    {
+        _runner = runner;
+        _config = config ?? new CodexAppServerConfigWriter();
+    }
+
+    public async Task<AgentPluginCatalog> GetCatalogAsync(CancellationToken token = default)
+    {
+        string plugins = await _runner.RunAsync(["plugin", "list", "--json", "--available"], token);
+        string marketplaces = await _runner.RunAsync(["plugin", "marketplace", "list", "--json"], token);
+        return ParseCatalog(plugins, marketplaces);
+    }
+
+    public async Task<AgentPluginCatalog> GetInstalledCatalogAsync(CancellationToken token = default)
+    {
+        string plugins = await _runner.RunAsync(["plugin", "list", "--json"], token);
+        string marketplaces = await _runner.RunAsync(["plugin", "marketplace", "list", "--json"], token);
+        return ParseInstalledCatalog(plugins, marketplaces);
+    }
+
+    public async Task<AgentPluginCatalog> GetMarketplaceCatalogAsync(string marketplace, CancellationToken token = default)
+    {
+        string name = AgentPluginInput.Segment(marketplace);
+        string output = await _runner.RunAsync(["plugin", "list", "--json", "--available", "--marketplace", name], token);
+        var catalog = Deserialize(output, CodexPluginJsonContext.Default.CodexPluginList)
+            ?? throw new JsonException(CoreTools.Translate("Codex returned an empty plugin inventory."));
+        if (catalog.Available is null)
+            throw new JsonException(CoreTools.Translate("Unsupported Codex plugin inventory. Update the Codex CLI and try again."));
+        var plugins = catalog.Available.Select(item =>
+        {
+            string id = AgentPluginInput.PluginId(item.PluginId ?? "");
+            if (!string.Equals(id.Split('@')[1], name, StringComparison.Ordinal))
+                throw new JsonException(CoreTools.Translate("Codex returned a plugin for the wrong marketplace."));
+            return new AgentPluginItem(id, item.Description ?? "", item.Version ?? "", false, false)
+            {
+                CanInstall = item.InstallPolicy != "NOT_AVAILABLE",
+                Notice = item.InstallPolicy == "NOT_AVAILABLE" ? CoreTools.Translate("Unavailable under Codex policy.") : null,
+            };
+        }).ToArray();
+        return new(plugins, []);
+    }
+
+    private static AgentPluginCatalog ParseInstalledCatalog(string plugins, string marketplaces)
+    {
+        var catalog = Deserialize(plugins, CodexPluginJsonContext.Default.CodexPluginList)
+            ?? throw new JsonException(CoreTools.Translate("Codex returned an empty plugin inventory."));
+        if (catalog.Installed is null)
+            throw new JsonException(CoreTools.Translate("Unsupported Codex plugin inventory. Update the Codex CLI and try again."));
+        var items = catalog.Installed.Select(item =>
+        {
+            string id = AgentPluginInput.PluginId(item.PluginId ?? "");
+            return ForHost(new AgentPluginItem(id, item.Description ?? "", item.Version ?? "", true, item.Enabled));
+        }).ToArray();
+        return new(items, ParseMarketplaces(marketplaces));
+    }
+
+    private static AgentPluginItem ForHost(AgentPluginItem item) => item.IsInstalled && AppMarketplaces.Contains(item.Marketplace)
+        ? item with
+        {
+            CanManage = false,
+            CanToggle = true,
+            Notice = item.Notice ?? CoreTools.Translate("Provided by the Codex app, which restores it if removed. You can still turn it on or off."),
+        }
+        : item;
+
+    internal static AgentPluginCatalog ParseCatalog(string plugins, string marketplaces)
+    {
+        var catalog = Deserialize(plugins, CodexPluginJsonContext.Default.CodexPluginList)
+            ?? throw new JsonException(CoreTools.Translate("Codex returned an empty plugin inventory."));
+        var markets = Deserialize(marketplaces, CodexPluginJsonContext.Default.CodexMarketplaceList)
+            ?? throw new JsonException(CoreTools.Translate("Codex returned an empty marketplace inventory."));
+        if (catalog.Installed is null || catalog.Available is null || markets.Marketplaces is null)
+            throw new JsonException(CoreTools.Translate("Unsupported Codex plugin inventory. Update the Codex CLI and try again."));
+        Dictionary<string, AgentPluginItem> items = new(StringComparer.Ordinal);
+        foreach (var item in catalog.Available.Concat(catalog.Installed))
+        {
+            string id = AgentPluginInput.PluginId(item.PluginId ?? "");
+            items[id] = ForHost(new(id, item.Description ?? "", item.Version ?? "", item.Installed, item.Enabled)
+            {
+                CanInstall = item.InstallPolicy != "NOT_AVAILABLE",
+                Notice = item.InstallPolicy == "NOT_AVAILABLE" ? CoreTools.Translate("Unavailable under Codex policy.") : null,
+            });
+        }
+        return new(items.Values.OrderBy(item => item.Id, StringComparer.OrdinalIgnoreCase).ToArray(),
+            ParseMarketplaces(marketplaces));
+    }
+
+    private static AgentPluginMarketplace[] ParseMarketplaces(string marketplaces)
+    {
+        var markets = Deserialize(marketplaces, CodexPluginJsonContext.Default.CodexMarketplaceList)
+            ?? throw new JsonException(CoreTools.Translate("Codex returned an empty marketplace inventory."));
+        if (markets.Marketplaces is null)
+            throw new JsonException(CoreTools.Translate("Unsupported Codex marketplace inventory. Update the Codex CLI and try again."));
+        return markets.Marketplaces.Select(item => new AgentPluginMarketplace(AgentPluginInput.Segment(item.Name ?? ""),
+            item.MarketplaceSource?.Source ?? item.Root ?? "")
+        { CanManage = item.MarketplaceSource is not null }).ToArray();
+    }
+
+    public Task<string> AddMarketplaceAsync(string input, CancellationToken token = default) =>
+        _runner.RunAsync(["plugin", "marketplace", "add",
+            AgentPluginInput.Value(AgentPluginInput.StripCommand(input, "codex plugin marketplace add ", "/plugin marketplace add "))], token);
+    public Task<string> UpdateMarketplaceAsync(string name, CancellationToken token = default) =>
+        _runner.RunAsync(["plugin", "marketplace", "upgrade", AgentPluginInput.Segment(name)], token);
+    public Task<string> RemoveMarketplaceAsync(string name, CancellationToken token = default) =>
+        _runner.RunAsync(["plugin", "marketplace", "remove", AgentPluginInput.Segment(name)], token);
+
+    private static T? Deserialize<T>(string json, JsonTypeInfo<T> typeInfo) =>
+        JsonSerializer.Deserialize(json, typeInfo);
+
+    public Task<string> PerformAsync(string input, AgentPluginAction action, CancellationToken token = default)
+    {
+        string id = AgentPluginInput.PluginId(AgentPluginInput.StripCommand(input,
+            "codex plugin add ", "/plugin install "));
+        if (action is AgentPluginAction.Enable or AgentPluginAction.Disable)
+            return _config.SetPluginEnabledAsync(id, action == AgentPluginAction.Enable, token);
+        string command = action switch
+        {
+            AgentPluginAction.Install => "add",
+            AgentPluginAction.Uninstall => "remove",
+            _ => throw new NotSupportedException(CoreTools.Translate("Manage this plugin action in Codex. The Codex CLI does not expose it.")),
+        };
+        return _runner.RunAsync(["plugin", command, id], token);
+    }
+}
+
+internal sealed class CodexPluginList
+{
+    public CodexPluginEntry[]? Installed { get; set; }
+    public CodexPluginEntry[]? Available { get; set; }
+}
+internal sealed class CodexPluginEntry
+{
+    public string? PluginId { get; set; }
+    public string? Description { get; set; }
+    public string? Version { get; set; }
+    public bool Installed { get; set; }
+    public bool Enabled { get; set; }
+    public string? InstallPolicy { get; set; }
+}
+internal sealed class CodexMarketplaceList
+{
+    public CodexMarketplaceEntry[]? Marketplaces { get; set; }
+}
+internal sealed class CodexMarketplaceEntry
+{
+    public string? Name { get; set; }
+    public string? Root { get; set; }
+    public CodexMarketplaceSource? MarketplaceSource { get; set; }
+}
+internal sealed class CodexMarketplaceSource
+{
+    public string? Source { get; set; }
+}
+
+[JsonSourceGenerationOptions(PropertyNamingPolicy = JsonKnownNamingPolicy.CamelCase)]
+[JsonSerializable(typeof(CodexPluginList))]
+[JsonSerializable(typeof(CodexMarketplaceList))]
+internal sealed partial class CodexPluginJsonContext : JsonSerializerContext;
diff --git a/src/UniGetUI.Extensions.AgentSkills/CopilotAppPluginService.cs b/src/UniGetUI.Extensions.AgentSkills/CopilotAppPluginService.cs
