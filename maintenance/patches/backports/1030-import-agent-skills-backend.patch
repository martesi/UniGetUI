+                });
+                continue;
+            }
+            if (!installedDirs.TryGetValue(s.InstallName, out var dir) || dir.Length == 0 || TryComputeHash(dir) is not { } hash) continue;
+            TryAddToLocalLock(s.InstallName, new JsonObject
+            {
