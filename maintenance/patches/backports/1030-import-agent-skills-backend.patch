new file mode 100644
index 0000000..172985e
--- /dev/null
+++ b/src/UniGetUI.Extensions.AgentSkills/NotionCliTool.cs
@@ -0,0 +1,66 @@
+using System.Text.RegularExpressions;
+using UniGetUI.Core.SettingsEngine;
+using UniGetUI.Core.Tools;
+
+namespace UniGetUI.Extensions.AgentSkills;
+
+public static partial class NotionCliTool
+{
+    public const string Name = "Notion CLI";
+    [GeneratedRegex(@"^\d{1,4}(?:\.\d{1,6}){1,3}(?:-[0-9A-Za-z][0-9A-Za-z.-]{0,31})?$")]
+    private static partial Regex VersionPattern();
+    public static bool IsValidVersion(string version) => VersionPattern().IsMatch(version);
+    public static string? PinnedVersion =>
+        Settings.GetValue(Settings.K.SkillsNotionCliVersion).Trim() is { Length: > 0 } version && IsValidVersion(version)
+            ? version : null;
+    public static bool TrySetPinnedVersion(string version)
+    {
+        version = version.Trim();
+        if (version.Length > 0 && !IsValidVersion(version)) return false;
+        Settings.SetValue(Settings.K.SkillsNotionCliVersion, version);
+        return true;
+    }
+
+    private static readonly Lock CacheLock = new();
+    private static string? _cachedPath;
+    private static DateTime _checkedAt = DateTime.MinValue;
+    public static void Forget()
+    {
+        lock (CacheLock) { _cachedPath = null; _checkedAt = DateTime.MinValue; }
+    }
+    public static string? FindExecutable()
+    {
+        lock (CacheLock)
+        {
+            if (_cachedPath is not null ? File.Exists(_cachedPath) : DateTime.UtcNow - _checkedAt < TimeSpan.FromSeconds(30))
+                return _cachedPath;
+            _cachedPath = Locate();
+            _checkedAt = DateTime.UtcNow;
+            return _cachedPath;
+        }
+    }
+    private static string? Locate()
+    {
+        var (found, path) = CoreTools.Which(OperatingSystem.IsWindows() ? "ntn.exe" : "ntn");
+        if (found) return path;
+        if (OperatingSystem.IsWindows())
+        {
+            string local = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
+            foreach (string links in new[]
+            {
+                Path.Combine(local, "Microsoft", "WinGet", "Links"),
+                Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ProgramFiles), "WinGet", "Links"),
+            })
+                if (File.Exists(Path.Combine(links, "ntn.exe"))) return Path.Combine(links, "ntn.exe");
+            string packages = Path.Combine(local, "Microsoft", "WinGet", "Packages");
+            if (Directory.Exists(packages))
+                foreach (string folder in Directory.EnumerateDirectories(packages, "Notion.ntn_*"))
+                    if (Directory.EnumerateFiles(folder, "ntn.exe", SearchOption.AllDirectories).FirstOrDefault() is { } exe)
+                        return exe;
+            return null;
+        }
+        string home = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
+        return new[] { Path.Combine(home, ".local", "bin", "ntn"), Path.Combine(home, ".ntn", "bin", "ntn"), "/opt/homebrew/bin/ntn", "/usr/local/bin/ntn" }
+            .FirstOrDefault(File.Exists);
+    }
+}
diff --git a/src/UniGetUI.Extensions.AgentSkills/SkillsShClient.cs b/src/UniGetUI.Extensions.AgentSkills/SkillsShClient.cs
new file mode 100644
index 0000000..45a3629
--- /dev/null
+++ b/src/UniGetUI.Extensions.AgentSkills/SkillsShClient.cs
@@ -0,0 +1,117 @@
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using System.Text.RegularExpressions;
+using UniGetUI.Core.Data;
+using UniGetUI.Core.Logging;
+using UniGetUI.Core.Tools;
+
+namespace UniGetUI.Extensions.AgentSkills;
+
+internal sealed record SkillsShResult(string Name, SkillSourceLocator Source);
+
+internal interface ISkillsShClient
+{
+    IReadOnlyList<SkillsShResult> Search(string query);
+}
+
+internal sealed partial class SkillsShClient(HttpMessageHandler? handler = null) : ISkillsShClient
+{
+    internal const int ResultLimit = 50;
+    internal const long MaxResponseBytes = 1024 * 1024;
+    internal static readonly TimeSpan RequestTimeout = TimeSpan.FromSeconds(10);
+
+    [GeneratedRegex(@"\A[\p{L}\p{N}][\p{L}\p{N} ._:-]{0,127}\z")]
+    private static partial Regex SkillName();
+
+    [GeneratedRegex(@"\A[A-Za-z0-9][A-Za-z0-9._-]{0,127}\z")]
+    private static partial Regex SkillSlug();
+
+    [GeneratedRegex(@"\A(?=.{1,253}\z)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}\z")]
+    private static partial Regex WebsiteHost();
+
+    public IReadOnlyList<SkillsShResult> Search(string query) =>
+        SearchAsync(query).GetAwaiter().GetResult();
+
+    private async Task<IReadOnlyList<SkillsShResult>> SearchAsync(string query)
+    {
+        query = query.Trim();
+        if (query.Length < 2)
+            return [];
+
+        using var client = new HttpClient(handler ?? CoreTools.GenericHttpClientParameters, disposeHandler: handler is null)
+        {
+            Timeout = RequestTimeout,
+            MaxResponseContentBufferSize = MaxResponseBytes,
+        };
+        client.DefaultRequestHeaders.UserAgent.ParseAdd(CoreData.UserAgentString);
+        var uri = new Uri($"https://skills.sh/api/search?q={Uri.EscapeDataString(query)}&limit={ResultLimit}");
+        using var response = await client.GetAsync(uri).ConfigureAwait(false);
+        response.EnsureSuccessStatusCode();
+        var json = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
+        var payload = JsonSerializer.Deserialize(json, SkillsShJsonContext.Default.SkillsShResponse);
+        if (payload?.Skills is null)
+            throw new JsonException("The skills.sh response did not contain a skills list.");
+
+        List<SkillsShResult> results = [];
+        HashSet<(string Source, string Name)> seen = [];
+        foreach (var skill in payload.Skills.Take(ResultLimit))
+        {
+            var source = ParseSource(skill?.Source);
+            // The website slug is not the install selector: e.g. "reactcomponents" vs "react:components".
+            string? slug = skill?.SkillId ?? skill?.Id?.Split('/').LastOrDefault();
+            if (skill?.Name is not { } name || !SkillName().IsMatch(name)
+                || source is null || slug is null || !SkillSlug().IsMatch(slug)
+                || !string.Equals(skill.Id, $"{skill.Source}/{slug}", StringComparison.OrdinalIgnoreCase))
+            {
+                Logger.Warn("Ignoring an invalid skills.sh search result");
+                continue;
+            }
+
+            if (seen.Add((source.Name, name)))
+                results.Add(new(name, source));
+        }
+        return results;
+    }
+
+    private static SkillSourceLocator? ParseSource(string? value)
+    {
+        if (value is null || value.Length > 253)
+            return null;
+
+        if (value.Split('/') is [_, _])
+        {
+            var repository = SkillSourceLocator.Parse(value);
+            return repository is { IsGitHub: true }
+                && value.Equals(repository.Name, StringComparison.OrdinalIgnoreCase) ? repository : null;
+        }
+
+        if (!WebsiteHost().IsMatch(value)
+            || new[] { ".localhost", ".local", ".localdomain", ".internal", ".test", ".invalid", ".example" }
+                .Any(suffix => value.EndsWith(suffix, StringComparison.OrdinalIgnoreCase)))
+            return null;
+
+        return SkillSourceLocator.Parse($"https://{value}") is { Kind: SkillSourceKind.Index } index
+            ? index : null;
+    }
+}
+
+internal sealed record SkillsShResponse
+{
+    [JsonPropertyName("skills")]
+    public SkillsShEntry?[]? Skills { get; init; }
+}
+
+internal sealed record SkillsShEntry
+{
+    [JsonPropertyName("id")]
+    public string? Id { get; init; }
+    [JsonPropertyName("name")]
+    public string? Name { get; init; }
+    [JsonPropertyName("source")]
+    public string? Source { get; init; }
+    [JsonPropertyName("skillId")]
+    public string? SkillId { get; init; }
+}
+
+[JsonSerializable(typeof(SkillsShResponse))]
+internal sealed partial class SkillsShJsonContext : JsonSerializerContext;
diff --git a/src/UniGetUI.Extensions.AgentSkills/Sources/SkillSourceListings.cs b/src/UniGetUI.Extensions.AgentSkills/Sources/SkillSourceListings.cs
new file mode 100644
index 0000000..7339d3b
--- /dev/null
+++ b/src/UniGetUI.Extensions.AgentSkills/Sources/SkillSourceListings.cs
@@ -0,0 +1,113 @@
+using System.Collections.Concurrent;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using Devolutions.AgentSkills;
+using UniGetUI.Core.Logging;
+
+namespace UniGetUI.Extensions.AgentSkills;
+
+/// <summary>Browsing reuses metadata; only an explicit refresh fetches an already known source.</summary>
+internal sealed class SkillSourceListings(ISkillsBackend backend, string? cacheDirectory = null)
+{
+    private readonly ConcurrentDictionary<string, IReadOnlyList<AvailableSkill>> _listings = new(StringComparer.Ordinal);
+    private const int MaxCacheBytes = 8 * 1024 * 1024;
+
+    public IReadOnlyList<AvailableSkill> Get(SkillSourceLocator source, IProgress<string>? progress, CancellationToken token,
+        bool refresh = false)
+    {
+        token.ThrowIfCancellationRequested();
+        if (!refresh && source.Kind is not SkillSourceKind.Notion)
+        {
+            if (_listings.TryGetValue(source.InstallSource, out var cached)) return cached;
+            if (Read(source) is { } saved)
+            {
+                _listings[source.InstallSource] = saved;
+                return saved;
+            }
+        }
+        var skills = backend.GetAvailableSkills(source.InstallSource, progress, token);
+        token.ThrowIfCancellationRequested();
+        Store(source, skills);
+        return skills;
+    }
+
+    public void Store(SkillSourceLocator source, IReadOnlyList<AvailableSkill> skills)
+    {
+        _listings[source.InstallSource] = skills;
+        if (CachePath(source) is not { } path) return;
+        string temporary = path + "." + Guid.NewGuid().ToString("N") + ".tmp";
+        try
+        {
+            var typeInfo = SkillListingJsonContext.Default.SkillListingSnapshot;
+            var data = JsonSerializer.SerializeToUtf8Bytes(new SkillListingSnapshot
+            {
+                Version = 1,
+                Source = source.InstallSource,
+                Skills = skills.ToArray(),
+            }, typeInfo);
+            if (data.Length > MaxCacheBytes)
+            {
+                Logger.Warn($"Skill listing is too large to cache: {source.Name}");
+                return;
+            }
+            Directory.CreateDirectory(cacheDirectory!);
+            File.WriteAllBytes(temporary, data);
+            File.Move(temporary, path, overwrite: true);
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+        {
+            Logger.Warn("Could not save the skill source listing cache.");
+            Logger.Warn(ex);
+        }
+        finally
+        {
+            try { if (File.Exists(temporary)) File.Delete(temporary); }
+            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException) { Logger.Warn(ex); }
+        }
+    }
+
+    public void Forget(SkillSourceLocator source)
+    {
+        _listings.TryRemove(source.InstallSource, out _);
+        if (CachePath(source) is not { } path) return;
+        try { File.Delete(path); }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException) { Logger.Warn(ex); }
+    }
+
+    private string? CachePath(SkillSourceLocator source) => cacheDirectory is null || source.Kind == SkillSourceKind.Notion
+        ? null : Path.Combine(cacheDirectory, Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(source.InstallSource))) + ".json");
+
+    private IReadOnlyList<AvailableSkill>? Read(SkillSourceLocator source)
+    {
+        if (CachePath(source) is not { } path || !File.Exists(path)) return null;
+        try
+        {
+            using var stream = File.OpenRead(path);
+            if (stream.Length > MaxCacheBytes) throw new InvalidDataException("Skill listing cache exceeds the size limit.");
+            var typeInfo = SkillListingJsonContext.Default.SkillListingSnapshot;
+            var snapshot = JsonSerializer.Deserialize(stream, typeInfo);
+            if (snapshot is not { Version: 1, Skills: not null } || snapshot.Source != source.InstallSource
+                || snapshot.Skills.Any(skill => skill is null || string.IsNullOrWhiteSpace(skill.Name) || skill.Description is null))
+                throw new InvalidDataException("Unsupported skill listing cache.");
+            return snapshot.Skills;
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidDataException or JsonException)
+        {
+            Logger.Warn("Could not read the skill source listing cache; fetching the source again.");
+            Logger.Warn(ex);
+            return null;
+        }
+    }
+}
+
+internal sealed class SkillListingSnapshot
+{
+    public int Version { get; set; }
+    public string? Source { get; set; }
+    public AvailableSkill[]? Skills { get; set; }
+}
+
+[JsonSerializable(typeof(SkillListingSnapshot))]
+internal sealed partial class SkillListingJsonContext : JsonSerializerContext;
diff --git a/src/UniGetUI.Extensions.AgentSkills/Sources/SkillSourceLocator.cs b/src/UniGetUI.Extensions.AgentSkills/Sources/SkillSourceLocator.cs
new file mode 100644
index 0000000..feeaefb
--- /dev/null
+++ b/src/UniGetUI.Extensions.AgentSkills/Sources/SkillSourceLocator.cs
@@ -0,0 +1,313 @@
+using System.Text.RegularExpressions;
+using Devolutions.AgentSkills;
+
+namespace UniGetUI.Extensions.AgentSkills;
+
+public enum SkillSourceKind
+{
+    /// <summary>A website that publishes a well-known skills index (RFC 8615).</summary>
+    Index,
+
+    /// <summary>A git repository: GitHub, GitLab, Azure DevOps or any git URL.</summary>
+    Repository,
+
+    /// <summary>A Notion skills database (or one skill page), read through the Notion CLI.</summary>
+    Notion,
+}
+
+/// <summary>
+/// Where skills come from, parsed from what a user typed, a search result or a lock-file entry.
+/// The library parses sources again with rules of its own, so it is handed the address as parsed
+/// here, and anything the two could read differently is refused.
+/// </summary>
+/// <param name="Kind">The kind of source</param>
+/// <param name="Name">
+/// The source name UniGetUI shows and compares: owner/repo for GitHub, host and path for
+/// other repositories and path-scoped indexes, the host for a root index, and the
+/// canonical Notion database address. A well-known lock entry separately records its index URL.
+/// </param>
+/// <param name="InstallSource">What the library installs from</param>
+/// <param name="Url">A browsable address for the source</param>
+public sealed partial record SkillSourceLocator(
+    SkillSourceKind Kind,
+    string Name,
+    string InstallSource,
+    Uri Url
+)
+{
+    [GeneratedRegex(@"^(?:github:)?([A-Za-z0-9][A-Za-z0-9-]*)/([A-Za-z0-9._-]+)$")]
+    private static partial Regex GitHubShorthand();
+
+    // Hosts, user names and paths are limited to characters that git and ssh cannot take for options
+    [GeneratedRegex(
+        @"^(?:git@([A-Za-z0-9][A-Za-z0-9.-]*):|ssh://(?:[A-Za-z0-9_][A-Za-z0-9._-]*@)?([A-Za-z0-9][A-Za-z0-9.-]*)(?::\d+)?/)([A-Za-z0-9_~][A-Za-z0-9._~/-]*)$"
+    )]
+    private static partial Regex SshGitUrl();
+
+    // The page or database id that ends a Notion address's last path segment
+    [GeneratedRegex(
+        "(?:^|-)([0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$",
+        RegexOptions.IgnoreCase
+    )]
+    private static partial Regex NotionId();
+
+    public bool IsGitHub =>
+        Kind is SkillSourceKind.Repository
+        && Url.Host.Equals("github.com", StringComparison.OrdinalIgnoreCase);
+
+    /// <summary>The owner of a GitHub repository; null for any other source.</summary>
+    public string? GitHubOwner => IsGitHub ? Name.Split('/')[0] : null;
+
+    /// <summary>
+    /// A GitHub repository. It is installed from its github.com address rather than as owner/repo,
+    /// which the library would resolve against a GitHub Enterprise host selected with GH_HOST.
+    /// </summary>
+    public static SkillSourceLocator GitHub(string owner, string repository)
+    {
+        repository = StripDotGit(repository);
+        var url = new Uri($"https://github.com/{owner}/{repository}");
+        return new(SkillSourceKind.Repository, $"{owner}/{repository}".ToLowerInvariant(), url.AbsoluteUri, url);
+    }
+
+    /// <summary>
+    /// Parses a source as the skills CLI accepts it: owner/repo, a GitHub, GitLab, Azure DevOps or
+    /// git URL, the address of a website that publishes a well-known skills index, or the address
+    /// of a Notion skills database or skill page. Returns null
+    /// for anything else, including local paths, which UniGetUI does not offer as sources, web
+    /// addresses that are not encrypted or that carry a user name or password, and GitHub addresses
+    /// other than a repository or a folder of one.
+    /// </summary>
+    public static SkillSourceLocator? Parse(string? input)
+    {
+        if (string.IsNullOrWhiteSpace(input))
+            return null;
+
+        input = input.Trim();
+        if (input.Any(c => c == '\\' || char.IsWhiteSpace(c) || char.IsControl(c)))
+            return null;
+
+        var shorthand = GitHubShorthand().Match(input);
+        if (shorthand.Success)
+            return TryGitHub(shorthand.Groups[1].Value, shorthand.Groups[2].Value);
+
+        var ssh = SshGitUrl().Match(input);
+        if (ssh.Success)
+            return ParseSsh(input, ssh);
+
+        if (
+            !Uri.TryCreate(input, UriKind.Absolute, out Uri? uri)
+            || !IsEncryptedOrLocal(uri)
+            || uri.UserInfo.Length > 0
+        )
+            return null;
+
+        string host = uri.Host.ToLowerInvariant();
+        string[] segments = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
+
+        if (host is "github.com" or "www.github.com")
+            return ParseGitHubUrl(uri, segments);
+
+        if (IsNotionHost(host))
+            return ParseNotion(segments);
+
+        bool isRepository =
+            host == "gitlab.com"
+            || uri.AbsolutePath.TrimEnd('/').EndsWith(".git", StringComparison.OrdinalIgnoreCase)
+            || segments.Contains("_git");
+        if (isRepository)
+        {
+            // GitLab tree URLs append /-/tree/<ref>/<path> to the repository path; its other /-/
+            // pages, such as archive downloads, are not sources
+            int dash = Array.IndexOf(segments, "-");
+            if (dash >= 0 && (dash + 1 == segments.Length || segments[dash + 1] != "tree"))
+                return null;
+
+            string[] repositoryPath = dash >= 0 ? segments[..dash] : segments;
+            if (repositoryPath.Length < 2)
+                return null;
+
+            repositoryPath[^1] = StripDotGit(repositoryPath[^1]);
+            return new(
+                SkillSourceKind.Repository,
+                $"{host}/{string.Join('/', repositoryPath)}".ToLowerInvariant(),
+                Canonical(uri),
+                uri
+            );
+        }
+
+        // Include the index path so independent indexes on one host have distinct identities.
+        // Root indexes retain their existing host-only names.
+        string indexHost = host.StartsWith("www.", StringComparison.Ordinal) ? host[4..] : host;
+        string indexPath = uri.AbsolutePath.TrimEnd('/');
+        return new(
+            SkillSourceKind.Index,
+            $"{indexHost}{(uri.IsDefaultPort ? "" : $":{uri.Port}")}{indexPath}",
+            Canonical(uri),
+            uri
+        );
+    }
+
+    /// <summary>
+    /// Parses what a person pasted as a source: anything <see cref="Parse"/> accepts, but also a
+    /// skills CLI command such as <c>npx skills add owner/repo</c>, an address without its https://
+    /// prefix (<c>github.com/owner/repo</c>), and an address wrapped in quotes or followed by a slash.
+    /// </summary>
+    public static SkillSourceLocator? ParseUserInput(string? input)
+    {
+        if (string.IsNullOrWhiteSpace(input))
+            return null;
+
+        string[] tokens = input.Trim().Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);
+        int add = Array.FindIndex(tokens, token => token.Equals("add", StringComparison.OrdinalIgnoreCase));
+        if (tokens.Length > 1)
+        {
+            if (add < 0 || add == tokens.Length - 1)
+                return null;
+            tokens = tokens[(add + 1)..].Where(token => !token.StartsWith('-')).Take(1).ToArray();
+            if (tokens.Length == 0)
+                return null;
+        }
+
+        string candidate = tokens[0].Trim('"', '\'', '`', '<', '>');
+        if (Parse(candidate) is { } parsed)
+            return parsed;
+
+        candidate = candidate.TrimEnd('/');
+        if (Parse(candidate) is { } trimmed)
+            return trimmed;
+
+        int slash = candidate.IndexOf('/');
+        string host = slash < 0 ? candidate : candidate[..slash];
+        return !candidate.Contains("://", StringComparison.Ordinal) && host.Contains('.')
+            ? Parse($"https://{candidate}")
+            : null;
+    }
+
+    /// <summary>
+    /// Whether skills from the given source come from this added source: the same repository, or,
+    /// for an index, the same website at or below this index's address. The lock file names an index
+    /// after its host only, so the address is what keeps an index on a shared host (a cloud storage
+    /// bucket, a CDN folder) from vouching for every other index on that host.
+    /// </summary>
+    public bool Covers(SkillSourceLocator other)
+    {
+        if (Kind != other.Kind || IsGitHub != other.IsGitHub)
+            return false;
+
+        if (Kind is not SkillSourceKind.Index)
+            return Name.Equals(other.Name, StringComparison.OrdinalIgnoreCase);
+
+        bool sameWebsite =
+            Uri.Compare(
+                Url,
+                other.Url,
+                UriComponents.SchemeAndServer,
+                UriFormat.SafeUnescaped,
+                StringComparison.OrdinalIgnoreCase
+            ) == 0;
+        string path = Url.AbsolutePath.TrimEnd('/');
+        string otherPath = other.Url.AbsolutePath.TrimEnd('/');
+        return sameWebsite
+            && (otherPath == path || otherPath.StartsWith(path + "/", StringComparison.Ordinal));
+    }
+
+    /// <summary>
+    /// The source an installed skill came from, as its lock-file entry records it; null for skills
+    /// installed from a local path or a direct download, and for skills no lock file tracks.
+    /// </summary>
+    public static SkillSourceLocator? ForInstalled(InstalledSkillInfo skill) =>
+        skill.SourceType switch
+        {
+            null or "local" or "download" or "node_modules" => null,
+            "github" => Parse(skill.Source) ?? Parse(skill.SourceUrl),
+            // The lock file names an index after its host; the URL it records is the skill file's,
+            // which the index picks and may put on any host
+            "well-known" => Parse(skill.SourceBaseUrl)
+                ?? (string.IsNullOrEmpty(skill.Source) ? null : Parse($"https://{skill.Source}")),
+            // The source is the database the skill is listed in; the URL is the skill's own page
+            "notion" => Parse(skill.Source),
+            _ => Parse(skill.SourceUrl) ?? Parse(skill.Source),
+        };
+
+    private static SkillSourceLocator? TryGitHub(string owner, string repository) =>
+        GitHubShorthand().IsMatch($"{owner}/{repository}") && StripDotGit(repository).Trim('.').Length > 0
+            ? GitHub(owner, repository)
+            : null;
+
+    private static SkillSourceLocator? ParseSsh(string input, Match ssh)
+    {
+        string host = (ssh.Groups[1].Success ? ssh.Groups[1].Value : ssh.Groups[2].Value).ToLowerInvariant();
+        string path = StripDotGit(ssh.Groups[3].Value.Trim('/'));
+        string[] segments = path.Split('/');
+        if (segments.Length < 2 || segments.Any(s => s is "" or "." or ".."))
+            return null;
+
+        if (host == "github.com")
+        {
+            return segments is [var owner, var repository] && TryGitHub(owner, repository) is { } github
+                ? github with { InstallSource = input }
+                : null;
+        }
+
+        return new(
+            SkillSourceKind.Repository,
+            $"{host}/{path}".ToLowerInvariant(),
+            input,
+            new Uri($"https://{host}/{path}")
+        );
+    }
+
+    /// <summary>
+    /// A GitHub repository address, or a tree address that selects a folder of it: installed from
+    /// that folder, with the repository as the source, as the lock file records it.
+    /// </summary>
+    private static SkillSourceLocator? ParseGitHubUrl(Uri uri, string[] segments)
+    {
+        if (segments.Length < 2 || TryGitHub(segments[0], segments[1]) is not { } repository)
+            return null;
+
+        if (segments.Length == 2)
+            return repository;
+
+        if (segments.Length < 4 || segments[2] != "tree")
+            return null;
+
+        var tree = new Uri($"https://github.com{uri.AbsolutePath.TrimEnd('/')}");
+        return repository with { InstallSource = tree.AbsoluteUri, Url = tree };
+    }
+
+    private static bool IsNotionHost(string host) =>
+        host is "notion.so" or "notion.com" or "notion.site"
+        || host.EndsWith(".notion.so", StringComparison.Ordinal)
+        || host.EndsWith(".notion.com", StringComparison.Ordinal)
+        || host.EndsWith(".notion.site", StringComparison.Ordinal);
+
+    /// <summary>
+    /// A Notion page or database: app.notion.com/p/id, notion.so/workspace/Title-id, or a
+    /// notion.site page. It is kept as its app.notion.com address, which the library records as the
+    /// source of the skills installed from it.
+    /// </summary>
+    private static SkillSourceLocator? ParseNotion(string[] segments)
+    {
+        if (segments.Length == 0 || NotionId().Match(Uri.UnescapeDataString(segments[^1])) is not { Success: true } id)
+            return null;
+
+        string raw = id.Groups[1].Value.Replace("-", "", StringComparison.Ordinal).ToLowerInvariant();
+        var address = new Uri($"https://app.notion.com/p/{raw}");
+        return new(SkillSourceKind.Notion, $"app.notion.com/p/{raw}", address.AbsoluteUri, address);
+    }
+
+    // Skills are instructions, and sometimes scripts, that coding agents act on, so they are only
+    // fetched over an encrypted connection, unless they come from this computer
+    private static bool IsEncryptedOrLocal(Uri uri) =>
+        uri.Scheme == Uri.UriSchemeHttps || (uri.Scheme == Uri.UriSchemeHttp && uri.IsLoopback);
+
+    // The address as parsed here, without the trailing slash of a bare website address
+    private static string Canonical(Uri uri) =>
+        uri.AbsolutePath == "/" && uri.Query.Length == 0 && uri.Fragment.Length == 0
+            ? uri.GetLeftPart(UriPartial.Authority)
+            : uri.AbsoluteUri;
+
+    private static string StripDotGit(string value) =>
+        value.EndsWith(".git", StringComparison.OrdinalIgnoreCase) ? value[..^4] : value;
+}
