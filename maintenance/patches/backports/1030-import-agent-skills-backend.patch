+        public string Home = "";
+        public string ConfigHome = "";
+        public string CodexHome = "";
+        public string ClaudeHome = "";
+        public string VibeHome = "";
+        public string HermesHome = "";
+        public string AutohandHome = "";
+        public string GrokHome = "";
