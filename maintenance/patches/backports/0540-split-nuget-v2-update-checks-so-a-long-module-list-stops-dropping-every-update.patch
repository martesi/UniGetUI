diff --git a/src/UniGetUI.PackageEngine.Managers.Cargo/CargoArchive.cs b/src/UniGetUI.PackageEngine.Managers.Cargo/CargoArchive.cs
new file mode 100644
index 0000000000000000000000000000000000000000..a8bf2507f528018b8ee8e91596ec1e701831d0e6
--- /dev/null
+++ b/src/UniGetUI.PackageEngine.Managers.Cargo/CargoArchive.cs
@@ -0,0 +1,116 @@
+using System.Formats.Tar;
+using System.IO.Compression;
+
+namespace UniGetUI.PackageEngine.Managers.CargoManager;
+
+internal static class CargoArchive
+{
+    internal const long ExpandedLimit = 512L * 1024 * 1024;
+    internal const int EntryLimit = 10000;
+
+    internal static string? Format(string name) =>
+        name.EndsWith(".tar.gz", StringComparison.OrdinalIgnoreCase)
+            || name.EndsWith(".tgz", StringComparison.OrdinalIgnoreCase) ? "tgz"
+        : name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase) ? "zip"
+        : name.EndsWith(".tar", StringComparison.OrdinalIgnoreCase) ? "tar"
+        : null;
+
+    internal static Dictionary<string, byte[]> Read(byte[] bytes, string format,
+        Func<string, bool> select, CancellationToken cancellationToken,
+        long selectedEntryLimit = ExpandedLimit)
+    {
+        Dictionary<string, byte[]> selected = new(StringComparer.Ordinal);
+        HashSet<string> paths = new(StringComparer.OrdinalIgnoreCase);
+        long expanded = 0;
+        int count = 0;
+        using MemoryStream input = new(bytes, writable: false);
+
+        void Entry(string rawName, Stream? content, long declaredSize, bool directory)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            if (++count > EntryLimit)
+                throw new InvalidDataException("Cargo archive contains too many entries.");
+            while (rawName.StartsWith("./", StringComparison.Ordinal))
+                rawName = rawName[2..];
+            if (directory && rawName.TrimEnd('/').Length == 0)
+                return;
+            string name = ValidateName(rawName.TrimEnd('/'));
+            if (!paths.Add(name))
+                throw new InvalidDataException($"Duplicate Cargo archive entry: {name}");
+            if (declaredSize < 0 || declaredSize > ExpandedLimit - expanded)
+                throw new InvalidDataException("Cargo archive expands beyond the allowed size.");
+            if (directory || content is null)
+                return;
+            bool keep = select(name);
+            if (keep && declaredSize > selectedEntryLimit)
+                throw new InvalidDataException("Selected Cargo archive entry exceeds the allowed size.");
+            using MemoryStream? output = keep ? new() : null;
+            byte[] buffer = new byte[64 * 1024];
+            long size = 0;
+            int read;
+            while ((read = content.Read(buffer)) != 0)
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+                size += read;
+                expanded += read;
+                if (expanded > ExpandedLimit || (keep && size > selectedEntryLimit))
+                    throw new InvalidDataException("Cargo archive expands beyond the allowed size.");
+                output?.Write(buffer, 0, read);
+            }
+            if (size != declaredSize)
+                throw new InvalidDataException($"Truncated Cargo archive entry: {name}");
+            if (output is not null)
+                selected.Add(name, output.ToArray());
+        }
+
+        if (format == "zip")
+        {
+            using ZipArchive archive = new(input, ZipArchiveMode.Read);
+            foreach (ZipArchiveEntry entry in archive.Entries)
+            {
+                int unixType = (entry.ExternalAttributes >> 16) & 0xF000;
+                if (unixType is not (0 or 0x8000 or 0x4000)
+                    || (entry.ExternalAttributes & (int)FileAttributes.ReparsePoint) != 0)
+                    throw new InvalidDataException("Cargo archive contains a link or special file.");
+                using Stream content = entry.Open();
+                Entry(entry.FullName, content, entry.Length, entry.FullName.EndsWith('/'));
+            }
+        }
+        else if (format is "tgz" or "tar")
+        {
+            using Stream decompressed = format == "tgz"
+                ? new GZipStream(input, CompressionMode.Decompress, leaveOpen: true)
+                : input;
+            using TarReader reader = new(decompressed);
+            TarEntry? entry;
+            while ((entry = reader.GetNextEntry()) is not null)
+            {
+                bool directory = entry.EntryType == TarEntryType.Directory;
+                if (!directory && entry.EntryType is not (TarEntryType.RegularFile or TarEntryType.V7RegularFile))
+                    throw new InvalidDataException("Cargo archive contains a link or special file.");
+                Entry(entry.Name, entry.DataStream, entry.Length, directory);
+            }
+        }
+        else
+            throw new NotSupportedException($"Unsupported Cargo archive format: {format}");
+        return selected;
+    }
+
+    internal static string ValidateName(string name)
+    {
+        if (string.IsNullOrWhiteSpace(name) || name.Contains('\\') || name.Contains(':')
+            || name.StartsWith('/') || name.Any(c => c < 32)
+            || name.Split('/').Any(part => part is "" or "." or ".."
+                || part.EndsWith(' ') || part.EndsWith('.') || IsDeviceName(part)))
+            throw new InvalidDataException($"Unsafe Cargo archive path: {name}");
+        return name;
+    }
+
+    internal static bool IsDeviceName(string name)
+    {
+        string stem = name.Split('.')[0].ToUpperInvariant();
+        return stem is "CON" or "PRN" or "AUX" or "NUL"
+            || (stem.Length == 4 && (stem.StartsWith("COM", StringComparison.Ordinal)
+                || stem.StartsWith("LPT", StringComparison.Ordinal)) && stem[3] is >= '1' and <= '9');
+    }
+}
diff --git a/src/UniGetUI.PackageEngine.Managers.Cargo/CargoBinaryResolver.cs b/src/UniGetUI.PackageEngine.Managers.Cargo/CargoBinaryResolver.cs
new file mode 100644
index 0000000000000000000000000000000000000000..d84910ea9e2bf1488cce53e8c6e194e171c4342c
--- /dev/null
+++ b/src/UniGetUI.PackageEngine.Managers.Cargo/CargoBinaryResolver.cs
@@ -0,0 +1,282 @@
+using System.Security.Cryptography;
+using System.Text;
+using Tomlyn.Model;
+using UniGetUI.Core.Tools;
+
+namespace UniGetUI.PackageEngine.Managers.CargoManager;
+
+internal sealed record CargoBinaryPlan(
+    string Id, string Version, string Target, string[] Binaries, Uri Url,
+    string Format, string Hash, string? BinaryPath);
+
+internal sealed record CargoRelease
+{
+    public string? tag_name { get; init; }
+    public bool draft { get; init; }
+    public CargoReleaseAsset[] assets { get; init; } = [];
+}
+
+internal sealed record CargoReleaseAsset
+{
+    public required string name { get; init; }
+    public required string browser_download_url { get; init; }
+    public string? digest { get; init; }
+}
+
+internal sealed class CargoBinaryResolver(CargoHttp http)
+{
+    internal static bool IsSupportedTarget(string target) =>
+        (target.StartsWith("x86_64-", StringComparison.Ordinal)
+            || target.StartsWith("aarch64-", StringComparison.Ordinal))
+        && (target.EndsWith("-pc-windows-msvc", StringComparison.Ordinal)
+            || target.EndsWith("-unknown-linux-gnu", StringComparison.Ordinal)
+            || target.EndsWith("-unknown-linux-musl", StringComparison.Ordinal)
+            || target.EndsWith("-apple-darwin", StringComparison.Ordinal));
+
+    internal async Task<CargoBinaryPlan?> ResolveAsync(string id, string version, string target,
+        CargoManifest manifest, Action<string> log, CancellationToken cancellationToken)
+    {
+        if (!IsSupportedTarget(target))
+            return Fallback("The Cargo host target is not supported by the binary installer.", log);
+        CargoManifestVersion selected = manifest.versions.Single(v => v.num == version);
+        if (selected.bin_names is not { Length: > 0 } binaries)
+            return Fallback("The published crate has no known executable names.", log);
+        foreach (string binary in binaries)
+            ValidateBinaryName(binary);
+        Uri crateUrl = new($"https://crates.io/api/v1/crates/{Uri.EscapeDataString(id)}/{Uri.EscapeDataString(version)}/download");
+        await CargoHttp.PaceApiAsync(cancellationToken);
+        byte[] source = await http.GetAsync(crateUrl, CargoHttp.ArchiveLimit, false, cancellationToken)
+            ?? throw new InvalidDataException("The published Cargo source archive is missing.");
+        VerifyHash(source, "sha256:" + selected.checksum);
+        string manifestPath = $"{id}-{version}/Cargo.toml";
+        var files = CargoArchive.Read(source, "tgz", name => name == manifestPath, cancellationToken,
+            CargoHttp.ManifestLimit);
+        if (!files.TryGetValue(manifestPath, out byte[]? manifestBytes)
+            || manifestBytes.Length > CargoHttp.ManifestLimit)
+            throw new InvalidDataException("The Cargo source archive has no valid package manifest.");
+        TomlTable document = CargoConfiguration.Parse(Encoding.UTF8.GetString(manifestBytes));
+        TomlTable package = CargoConfiguration.Table(document, "package")
+            ?? throw new InvalidDataException("Cargo manifest has no package table.");
+        if (CargoConfiguration.String(package, "name") != id
+            || CargoConfiguration.String(package, "version") != version)
+            throw new InvalidDataException("Cargo source manifest does not match the selected package.");
+        string? repository = CargoConfiguration.String(package, "repository");
+        TomlTable? metadata = CargoConfiguration.Table(package, "metadata");
+        TomlTable? binstall = metadata is null ? null : CargoConfiguration.Table(metadata, "binstall");
+        if (binstall is not null)
+        {
+            if (binstall.ContainsKey("signing"))
+                return Fallback("Publisher signing metadata requires an unsupported signature verifier.", log);
+            if (binstall.TryGetValue("disabled-strategies", out object? disabled)
+                && disabled is TomlArray strategies && strategies.OfType<string>().Contains("crate-meta-data"))
+                return Fallback("The publisher disabled release-binary installation.", log);
+            if (CargoConfiguration.Table(binstall, "overrides") is { } overrides)
+            {
+                if (overrides.Keys.Any(key => key.StartsWith("cfg(", StringComparison.Ordinal)))
+                    return Fallback("The publisher uses unsupported cfg target overrides.", log);
+                if (CargoConfiguration.Table(overrides, target) is { } targetOptions)
+                {
+                    var merged = new TomlTable();
+                    foreach (var item in binstall)
+                        merged[item.Key] = item.Value;
+                    foreach (var item in targetOptions)
+                        merged[item.Key] = item.Value;
+                    binstall = merged;
+                }
+                if (binstall.ContainsKey("signing")
+                    || binstall.Keys.Any(key => key is not ("pkg-url" or "pkg-fmt" or "bin-dir"
+                        or "overrides" or "disabled-strategies")))
+                    return Fallback("The publisher uses unsupported binary installation metadata.", log);
+            }
+        }
+
+        string? template = binstall is null ? null : CargoConfiguration.String(binstall, "pkg-url");
+        string? binaryPath = binstall is null ? null : CargoConfiguration.String(binstall, "bin-dir");
+        string? configuredFormat = binstall is null ? null : CargoConfiguration.String(binstall, "pkg-fmt");
+        if (template is not null)
+        {
+            if (!template.Replace(" ", "").Contains("{version}", StringComparison.Ordinal))
+                return Fallback("The publisher binary URL is not pinned to the package version.", log);
+            string? expanded = Expand(template, id, version, target, repository, configuredFormat, null);
+            if (expanded is null || !Uri.TryCreate(expanded, UriKind.Absolute, out Uri? url)
+                || url.Scheme != Uri.UriSchemeHttps)
+                return Fallback("The publisher binary URL uses unsupported metadata.", log);
+            string? format = configuredFormat ?? CargoArchive.Format(url.AbsolutePath);
+            if (!SupportedFormat(format))
+                return Fallback("The publisher binary archive format is unsupported.", log);
+            string? hash = await ReadSidecarAsync(url, cancellationToken);
+            return hash is null ? Fallback("The publisher binary has no supported checksum.", log)
+                : new(id, version, target, binaries, url, format!, hash, binaryPath);
+        }
+
+        if (!TryGitHubRepository(repository, out string? ownerAndRepo))
+            return Fallback("The publisher has no supported release repository or explicit binary URL.", log);
+        foreach (string tag in new[] { $"v{version}", version })
+        {
+            Uri releaseUrl = new($"https://api.github.com/repos/{ownerAndRepo}/releases/tags/{Uri.EscapeDataString(tag)}");
+            byte[]? json = await http.GetAsync(releaseUrl, CargoHttp.ManifestLimit, true, cancellationToken);
+            if (json is null)
+                continue;
+            CargoRelease release = CargoJson.Deserialize<CargoRelease>(Encoding.UTF8.GetString(json))
+                ?? throw new InvalidDataException("The publisher returned an empty release.");
+            if (release.draft || release.tag_name != tag)
+                throw new InvalidDataException("The publisher release does not match the selected version.");
+            var assets = release.assets.Where(asset => MatchesAsset(asset.name, id, version, target, binaries)).ToArray();
+            if (assets.Length > 1)
+                return Fallback("Several publisher binaries match; refusing to guess.", log);
+            if (assets.Length == 0)
+                continue;
+            var asset = assets[0];
+            Uri assetUrl = new(asset.browser_download_url);
+            string? hash = ValidHash(asset.digest) ? asset.digest : null;
+            if (hash is null)
+            {
+                foreach (var checksum in release.assets.Where(a =>
+                    a.name.Equals(asset.name + ".sha256", StringComparison.OrdinalIgnoreCase)
+                    || a.name.Equals(asset.name + ".sha512", StringComparison.OrdinalIgnoreCase)
+                    || a.name.Equals("SHA256SUMS", StringComparison.OrdinalIgnoreCase)
+                    || a.name.Equals("SHA512SUMS", StringComparison.OrdinalIgnoreCase)
+                    || a.name.Equals("checksums.txt", StringComparison.OrdinalIgnoreCase)))
+                {
+                    byte[]? text = await http.GetAsync(new Uri(checksum.browser_download_url),
+                        CargoHttp.ManifestLimit, false, cancellationToken);
+                    hash = ParseChecksum(Encoding.UTF8.GetString(text!), asset.name);
+                    if (hash is not null)
+                        break;
+                }
+            }
+            if (hash is null)
+                hash = await ReadSidecarAsync(assetUrl, cancellationToken);
+            return hash is null ? Fallback("The publisher binary has no supported checksum.", log)
+                : new(id, version, target, binaries, assetUrl, CargoArchive.Format(asset.name)!, hash, binaryPath);
+        }
+        return Fallback("No compatible publisher binary is available for this version and target.", log);
+    }
+
+    private static CargoBinaryPlan? Fallback(string reason, Action<string> log)
+    {
+        log(reason + " Using Cargo to build from source.");
+        return null;
+    }
+
+    internal static bool MatchesAsset(string name, string id, string version, string target, string[] binaries)
+    {
+        string? format = CargoArchive.Format(name);
+        if (format is null)
+            return false;
+        int suffixLength = name.EndsWith(".tar.gz", StringComparison.OrdinalIgnoreCase) ? 7 : 4;
+        string stem = name[..^suffixLength];
+        foreach (string prefix in binaries.Append(id).Distinct(StringComparer.Ordinal))
+        {
+            foreach (string separator in new[] { "-", "_" })
+            {
+                foreach (string tag in new[] { version, "v" + version })
+                {
+                    if (stem == $"{prefix}{separator}{tag}{separator}{target}"
+                        || stem == $"{prefix}{separator}{target}{separator}{tag}")
+                        return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    private static bool TryGitHubRepository(string? repository, out string? ownerAndRepo)
+    {
+        ownerAndRepo = null;
+        if (!Uri.TryCreate(repository, UriKind.Absolute, out Uri? uri)
+            || uri.Scheme != Uri.UriSchemeHttps || uri.Host != "github.com")
+            return false;
+        string[] parts = uri.AbsolutePath.Trim('/').Split('/');
+        if (parts.Length != 2 || parts.Any(part => part.Length == 0 || part.Any(c => !char.IsAsciiLetterOrDigit(c) && c is not ('-' or '_' or '.'))))
+            return false;
+        string repo = parts[1].EndsWith(".git", StringComparison.Ordinal) ? parts[1][..^4] : parts[1];
+        ownerAndRepo = parts[0] + "/" + repo;
+        return true;
+    }
+
+    internal static string? Expand(string template, string id, string version, string target,
+        string? repository, string? format, string? binary)
+    {
+        var variables = new Dictionary<string, string?>
+        {
+            ["name"] = id,
+            ["version"] = version,
+            ["target"] = target,
+            ["repo"] = repository?.TrimEnd('/'),
+            ["bin"] = binary,
+            ["binary-ext"] = target.Contains("-windows-") ? ".exe" : "",
+            ["archive-suffix"] = format is null ? null : format == "bin"
+                ? target.Contains("-windows-", StringComparison.Ordinal) ? ".exe" : ""
+                : format == "tgz" ? ".tar.gz" : "." + format,
+            ["archive-format"] = format,
+            ["format"] = format,
+        };
+        string result = template;
+        foreach (var variable in variables)
+        {
+            if (variable.Value is null)
+                continue;
+            result = result.Replace("{ " + variable.Key + " }", variable.Value, StringComparison.Ordinal)
+                .Replace("{" + variable.Key + "}", variable.Value, StringComparison.Ordinal);
+        }
+        return result.Contains('{') || result.Contains('}') ? null : result;
+    }
+
+    private static bool SupportedFormat(string? format) => format is "zip" or "tgz" or "tar" or "bin";
+
+    private async Task<string?> ReadSidecarAsync(Uri url, CancellationToken cancellationToken)
+    {
+        foreach (string suffix in new[] { ".sha256", ".sha512" })
+        {
+            Uri checksumUrl = new(url.AbsoluteUri + suffix);
+            byte[]? bytes = await http.GetAsync(checksumUrl, CargoHttp.ManifestLimit, true, cancellationToken);
+            if (bytes is not null)
+                return ParseChecksum(Encoding.UTF8.GetString(bytes), Path.GetFileName(url.AbsolutePath))
+                    ?? throw new InvalidDataException("The published binary checksum file is invalid or ambiguous.");
+        }
+        return null;
+    }
+
+    internal static string? ParseChecksum(string text, string assetName)
+    {
+        List<string> matches = [];
+        foreach (string line in text.Split('\n'))
+        {
+            string[] parts = line.Trim().Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);
+            if (parts.Length is < 1 or > 2)
+                continue;
+            string hash = parts[0];
+            if (parts.Length == 2 && parts[1].TrimStart('*') != assetName)
+                continue;
+            string candidate = (hash.Length == 128 ? "sha512:" : "sha256:") + hash;
+            if (ValidHash(candidate))
+                matches.Add(candidate);
+        }
+        return matches.Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1 ? matches[0] : null;
+    }
+
+    internal static bool ValidHash(string? hash) =>
+        hash is not null
+        && ((hash.StartsWith("sha256:", StringComparison.Ordinal) && hash.Length == 71)
+            || (hash.StartsWith("sha512:", StringComparison.Ordinal) && hash.Length == 135))
+        && hash[7..].All(char.IsAsciiHexDigit);
+
+    internal static void VerifyHash(byte[] bytes, string hash)
+    {
+        if (!ValidHash(hash))
+            throw new InvalidDataException("The publisher checksum is invalid or unsupported.");
+        byte[] actual = hash.StartsWith("sha256:", StringComparison.Ordinal)
+            ? SHA256.HashData(bytes) : SHA512.HashData(bytes);
+        if (!CryptographicOperations.FixedTimeEquals(actual, Convert.FromHexString(hash[7..])))
+            throw new InvalidDataException("Cargo download does not match its published checksum.");
+    }
+
+    internal static void ValidateBinaryName(string name)
+    {
+        if (name.Length == 0 || name.Length > 255
+            || name.Any(c => !char.IsAsciiLetterOrDigit(c) && c is not ('-' or '_' or '.'))
+            || name is "." or ".." || name.EndsWith('.') || CargoArchive.IsDeviceName(name))
+            throw new InvalidDataException($"Invalid Cargo executable name: {name}");
+    }
+}
diff --git a/src/UniGetUI.PackageEngine.Managers.Cargo/CargoConfiguration.cs b/src/UniGetUI.PackageEngine.Managers.Cargo/CargoConfiguration.cs
new file mode 100644
index 0000000000000000000000000000000000000000..e6861ec7fdf94719471661488aa3d724f17d3cf9
--- /dev/null
+++ b/src/UniGetUI.PackageEngine.Managers.Cargo/CargoConfiguration.cs
@@ -0,0 +1,81 @@
+using Tomlyn;
+using Tomlyn.Model;
+using Tomlyn.Serialization;
+
+namespace UniGetUI.PackageEngine.Managers.CargoManager;
+
+internal static class CargoConfiguration
+{
+    internal static string WorkingDirectory =>
+        Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
+
+    internal static string Home =>
+        Path.GetFullPath(Environment.GetEnvironmentVariable("CARGO_HOME")
+            is { Length: > 0 } home ? home : Path.Join(WorkingDirectory, ".cargo"), WorkingDirectory);
+
+    internal static TomlTable ReadConfiguration()
+    {
+        string legacy = Path.Join(Home, "config");
+        string path = File.Exists(legacy) ? legacy : Path.Join(Home, "config.toml");
+        return File.Exists(path) ? Parse(File.ReadAllText(path)) : new TomlTable();
+    }
+
+    internal static TomlTable Parse(string text) =>
+        TomlSerializer.Deserialize(text, CargoTomlContext.Default.TomlTable)
+        ?? throw new InvalidDataException("Cargo TOML document was empty.");
+
+    internal static string GetRoot(string? explicitRoot = null)
+    {
+        if (!string.IsNullOrWhiteSpace(explicitRoot))
+            return Path.GetFullPath(explicitRoot, WorkingDirectory);
+        if (Environment.GetEnvironmentVariable("CARGO_INSTALL_ROOT") is { Length: > 0 } root)
+            return Path.GetFullPath(root, WorkingDirectory);
+        var configuration = ReadConfiguration();
+        if (configuration.TryGetValue("install", out object? installValue))
+        {
+            if (installValue is not TomlTable install)
+                throw new InvalidDataException("Cargo install configuration must be a table.");
+            if (install.TryGetValue("root", out object? configured))
+            {
+                if (configured is not string { Length: > 0 } configuredRoot)
+                    throw new InvalidDataException("Cargo install.root configuration must be a nonempty path.");
+                return Path.GetFullPath(configuredRoot, Path.GetDirectoryName(Home) ?? Home);
+            }
+        }
+        return Home;
+    }
+
+    internal static TomlTable? Table(TomlTable table, string key) =>
+        table.TryGetValue(key, out object? value) ? value as TomlTable : null;
+
+    internal static string? String(TomlTable table, string key) =>
+        table.TryGetValue(key, out object? value) ? value as string : null;
+
+    internal static bool HasBuildOverrides()
+    {
+        TomlTable configuration = ReadConfiguration();
+        return Environment.GetEnvironmentVariable("CARGO_BUILD_TARGET") is { Length: > 0 }
+            || Environment.GetEnvironmentVariable("RUSTFLAGS") is { Length: > 0 }
+            || Environment.GetEnvironmentVariable("CARGO_ENCODED_RUSTFLAGS") is { Length: > 0 }
+            || Table(configuration, "build") is { Count: > 0 }
+            || Table(configuration, "target") is { Count: > 0 }
+            || Table(configuration, "source") is { Count: > 0 }
+            || Table(configuration, "registries") is { Count: > 0 }
+            || Table(configuration, "registry") is { Count: > 0 }
+            || configuration.ContainsKey("include");
+    }
+
+    internal static void RequireRegularPath(string path)
+    {
+        for (string? current = Path.GetFullPath(path); current is not null;
+            current = Path.GetDirectoryName(current))
+        {
+            if (Path.Exists(current)
+                && (File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
+                throw new InvalidDataException($"Cargo installation path contains a link: {current}");
+        }
+    }
+}
+
+[TomlSerializable(typeof(TomlTable))]
+internal partial class CargoTomlContext : TomlSerializerContext;
diff --git a/src/UniGetUI.PackageEngine.Managers.Cargo/CargoHttp.cs b/src/UniGetUI.PackageEngine.Managers.Cargo/CargoHttp.cs
new file mode 100644
index 0000000000000000000000000000000000000000..b513d26e4ed23a6797af0605b2b34d88849da93c
--- /dev/null
+++ b/src/UniGetUI.PackageEngine.Managers.Cargo/CargoHttp.cs
@@ -0,0 +1,89 @@
+using System.Diagnostics;
+using System.Net;
+using UniGetUI.Core.Data;
+using UniGetUI.Core.Tools;
+
+namespace UniGetUI.PackageEngine.Managers.CargoManager;
+
+internal sealed class CargoHttp : IDisposable
+{
+    internal const int ManifestLimit = 4 * 1024 * 1024;
+    internal const long ArchiveLimit = 256L * 1024 * 1024;
+    private static readonly SemaphoreSlim ApiGate = new(1);
+    private static long _lastApiRequest;
+    private readonly HttpClient _client;
+    internal static Func<HttpMessageHandler>? TestHandlerFactory { get; set; }
+
+    internal CargoHttp()
+    {
+        HttpMessageHandler handler;
+        if (TestHandlerFactory is { } factory)
+            handler = factory();
+        else
+        {
+            var configured = CoreTools.GenericHttpClientParameters;
+            configured.AllowAutoRedirect = false;
+            handler = configured;
+        }
+        _client = new HttpClient(handler) { Timeout = TimeSpan.FromMinutes(5) };
+        _client.DefaultRequestHeaders.UserAgent.ParseAdd(CoreData.UserAgentString);
+    }
+
+    internal static async Task PaceApiAsync(CancellationToken cancellationToken)
+    {
+        await ApiGate.WaitAsync(cancellationToken);
+        try
+        {
+            double elapsed = Stopwatch.GetElapsedTime(_lastApiRequest).TotalMilliseconds;
+            if (_lastApiRequest != 0 && elapsed < 1000)
+                await Task.Delay(TimeSpan.FromMilliseconds(1000 - elapsed), cancellationToken);
+            _lastApiRequest = Stopwatch.GetTimestamp();
+        }
+        finally
+        {
+            ApiGate.Release();
+        }
+    }
+
+    internal async Task<byte[]?> GetAsync(Uri url, long limit, bool allowMissing,
+        CancellationToken cancellationToken, Action<ulong, ulong>? progress = null)
+    {
+        for (int redirect = 0; redirect <= 5; redirect++)
+        {
+            if (url.Scheme != Uri.UriSchemeHttps || !string.IsNullOrEmpty(url.UserInfo))
+                throw new InvalidDataException($"Refusing a non-HTTPS or credential-bearing Cargo URL: {url}");
+            using HttpResponseMessage response = await _client.GetAsync(
+                url, HttpCompletionOption.ResponseHeadersRead, cancellationToken);
+            if ((int)response.StatusCode is 301 or 302 or 303 or 307 or 308)
+            {
+                url = response.Headers.Location is { } location
+                    ? new Uri(url, location)
+                    : throw new InvalidDataException("Cargo download redirect has no location.");
+                continue;
+            }
+            if (allowMissing && response.StatusCode is HttpStatusCode.NotFound or HttpStatusCode.Gone)
+                return null;
+            response.EnsureSuccessStatusCode();
+            long? length = response.Content.Headers.ContentLength;
+            if (length > limit)
+                throw new InvalidDataException("Cargo download exceeds the allowed size.");
+            await using Stream stream = await response.Content.ReadAsStreamAsync(cancellationToken);
+            using MemoryStream output = new();
+            byte[] buffer = new byte[64 * 1024];
+            int read;
+            while ((read = await stream.ReadAsync(buffer, cancellationToken)) != 0)
+            {
+                if (output.Length + read > limit)
+                    throw new InvalidDataException("Cargo download exceeds the allowed size.");
+                output.Write(buffer, 0, read);
+                progress?.Invoke((ulong)output.Length, (ulong)Math.Max(0, length ?? 0));
+            }
+            if (length is not null && output.Length != length)
+                throw new InvalidDataException("Cargo download was truncated.");
+            return output.ToArray();
+        }
+        throw new InvalidDataException("Too many Cargo download redirects.");
+    }
+
+    public void Dispose() => _client.Dispose();
+}
diff --git a/src/UniGetUI.PackageEngine.Managers.Cargo/CargoInstallTracker.cs b/src/UniGetUI.PackageEngine.Managers.Cargo/CargoInstallTracker.cs
new file mode 100644
index 0000000000000000000000000000000000000000..cd6a9183c82dad38b1619bf29a31431b5d819110
--- /dev/null
+++ b/src/UniGetUI.PackageEngine.Managers.Cargo/CargoInstallTracker.cs
@@ -0,0 +1,366 @@
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using Tomlyn;
+using Tomlyn.Model;
+using UniGetUI.Core.Logging;
+
+namespace UniGetUI.PackageEngine.Managers.CargoManager;
+
+internal sealed record CargoTransactionEntry(string Name, bool Existed, int? UnixMode = null, string? InstalledHash = null);
+internal sealed record CargoTransactionJournal(CargoTransactionEntry[] Entries, bool Committed,
+    string? V1Hash = null, string? V2Hash = null);
+
+internal static class CargoInstallTracker
+{
+    private const string TransactionDirectory = ".unigetui-cargo-transaction";
+
+    internal static async Task<IReadOnlyList<string>> GetBuildArgumentsAsync(
+        string root, string id, CancellationToken cancellationToken, string? hostTarget = null,
+        string[]? expectedBinaries = null)
+    {
+        if (!File.Exists(Path.Join(root, ".crates2.json")))
+            return [];
+        using var metadata = await CargoTrackingLock.AcquireAsync(root, cancellationToken);
+        Recover(root, metadata);
+        byte[] bytes = Read(metadata.V2);
+        if (bytes.Length == 0)
+            return [];
+        var document = JsonNode.Parse(bytes) as JsonObject
+            ?? throw new InvalidDataException("Invalid Cargo installation metadata.");
+        if (document["installs"] is not JsonObject installs)
+            throw new InvalidDataException("Invalid Cargo installation map.");
+        var entries = installs.Where(entry => entry.Key.StartsWith(id + " ", StringComparison.Ordinal)).ToArray();
+        if (entries.Length == 0)
+            return [];
+        if (entries.Length > 1 || entries[0].Value is not JsonObject info)
+            throw new InvalidDataException($"Cargo package {id} has ambiguous installed build settings.");
+        List<string> arguments = [];
+        if (info["features"] is JsonArray features && features.Count > 0)
+        {
+            string[] values = features.Select(feature => feature?.GetValue<string>()
+                ?? throw new InvalidDataException("Invalid installed Cargo feature.")).ToArray();
+            arguments.AddRange(["--features", UniGetUI.Core.Tools.CoreTools.EscapeCommandLineArgument(string.Join(',', values))]);
+        }
+        if (info["all_features"]?.GetValue<bool>() is true)
+            arguments.Add("--all-features");
+        if (info["no_default_features"]?.GetValue<bool>() is true)
+            arguments.Add("--no-default-features");
+        if (info["profile"]?.GetValue<string>() is { } profile && profile != "release")
+            arguments.AddRange(["--profile", UniGetUI.Core.Tools.CoreTools.EscapeCommandLineArgument(profile)]);
+        // An explicitly installed cross target cannot be inferred from the process architecture.
+        if (info["target"]?.GetValue<string>() is { Length: > 0 } target
+            && target != hostTarget)
+            arguments.AddRange(["--target", UniGetUI.Core.Tools.CoreTools.EscapeCommandLineArgument(target)]);
+        if (info["bins"] is JsonArray bins)
+        {
+            bool windows = info["target"]?.GetValue<string>()?.Contains("-windows-", StringComparison.Ordinal)
+                ?? OperatingSystem.IsWindows();
+            string[] names = bins.Select(bin => bin?.GetValue<string>()
+                ?? throw new InvalidDataException("Invalid installed Cargo binary name."))
+                .Select(bin => windows && bin.EndsWith(".exe", StringComparison.Ordinal) ? bin[..^4] : bin)
+                .ToArray();
+            if (expectedBinaries is not null
+                && !names.Order(StringComparer.Ordinal).SequenceEqual(expectedBinaries.Order(StringComparer.Ordinal)))
+            {
+                foreach (string name in names)
+                {
+                    CargoBinaryResolver.ValidateBinaryName(name);
+                    arguments.AddRange(["--bin", UniGetUI.Core.Tools.CoreTools.EscapeCommandLineArgument(name)]);
+                }
+            }
+        }
+        return arguments;
+    }
+
+    internal static async Task RecoverAsync(string root, CancellationToken cancellationToken)
+    {
+        if (!Directory.Exists(Path.Join(root, TransactionDirectory)))
+            return;
+        using var metadata = await CargoTrackingLock.AcquireAsync(root, cancellationToken);
+        Recover(root, metadata);
+    }
+
+    internal static async Task InstallAsync(string root, CargoBinaryPlan plan,
+        IReadOnlyDictionary<string, byte[]> binaries, CancellationToken cancellationToken)
+    {
+        if (binaries.Count == 0)
+            throw new InvalidDataException("A Cargo binary installation must contain executables.");
+        using var metadata = await CargoTrackingLock.AcquireAsync(root, cancellationToken);
+        Recover(root, metadata);
+        string binDirectory = Path.Join(root, "bin");
+        CargoConfiguration.RequireRegularPath(binDirectory);
+        Directory.CreateDirectory(binDirectory);
+        byte[] oldV1 = Read(metadata.V1);
+        byte[] oldV2 = Read(metadata.V2);
+        TomlTable v1Document = oldV1.Length == 0 ? new() : CargoConfiguration.Parse(Encoding.UTF8.GetString(oldV1));
+        TomlTable v1 = CargoConfiguration.Table(v1Document, "v1") ?? new TomlTable();
+        if (v1Document.ContainsKey("v1") && v1Document["v1"] is not TomlTable)
+            throw new InvalidDataException("Invalid Cargo v1 installation metadata.");
+        v1Document["v1"] = v1;
+        JsonObject v2Document = oldV2.Length == 0 ? new() :
+            JsonNode.Parse(oldV2) as JsonObject
+            ?? throw new InvalidDataException("Invalid Cargo v2 installation metadata.");
+        JsonObject installs = v2Document["installs"] as JsonObject ?? new();
+        if (v2Document.ContainsKey("installs") && v2Document["installs"] is not JsonObject)
+            throw new InvalidDataException("Invalid Cargo v2 installation map.");
+        if (!v2Document.ContainsKey("installs"))
+            v2Document["installs"] = installs;
+        string source = "(registry+https://github.com/rust-lang/crates.io-index)";
+        string key = $"{plan.Id} {plan.Version} {source}";
+        string[] previous = v1.Keys.Where(k => k.StartsWith(plan.Id + " ", StringComparison.Ordinal)
+            && k.EndsWith(source, StringComparison.Ordinal)).ToArray();
+        HashSet<string> oldBinaries = [];
+        JsonObject installedInfo = previous.Select(oldKey => installs[oldKey])
+            .OfType<JsonObject>().FirstOrDefault()?.DeepClone() as JsonObject ?? new();
+        foreach (string oldKey in previous)
+            oldBinaries.UnionWith(ReadBins(v1[oldKey]));
+        foreach (string binary in binaries.Keys)
+        {
+            CargoBinaryResolver.ValidateBinaryName(binary);
+            CargoConfiguration.RequireRegularPath(Path.Join(binDirectory, binary));
+            foreach (var package in v1)
+            {
+                if (!previous.Contains(package.Key, StringComparer.Ordinal)
+                    && ReadBins(package.Value).Contains(binary, StringComparer.OrdinalIgnoreCase))
+                    throw new IOException($"The executable {binary} is owned by another Cargo package.");
+            }
+            if (File.Exists(Path.Join(binDirectory, binary)) && !oldBinaries.Contains(binary))
+                throw new IOException($"Refusing to overwrite untracked executable {binary}.");
+        }
+        string[] affected = oldBinaries.Union(binaries.Keys, StringComparer.Ordinal).Order(StringComparer.Ordinal).ToArray();
+        foreach (string binary in affected)
+        {
+            CargoBinaryResolver.ValidateBinaryName(binary);
+            CargoConfiguration.RequireRegularPath(Path.Join(binDirectory, binary));
+        }
+        foreach (string oldKey in previous)
+        {
+            v1.Remove(oldKey);
+            installs.Remove(oldKey);
+        }
+        TomlArray trackedBins = new();
+        foreach (string name in binaries.Keys)
+            trackedBins.Add(name);
+        v1[key] = trackedBins;
+        JsonArray installedBins = new();
+        foreach (string name in binaries.Keys)
+        {
+            JsonNode? node = JsonValue.Create(name);
+            installedBins.Add(node);
+        }
+        installedInfo["version_req"] = "=" + plan.Version;
+        installedInfo["bins"] = installedBins;
+        installedInfo["features"] = new JsonArray();
+        installedInfo["all_features"] = false;
+        installedInfo["no_default_features"] = false;
+        installedInfo["profile"] = "release";
+        installedInfo["target"] = plan.Target;
+        installedInfo["rustc"] = null;
+        installs[key] = installedInfo;
+        byte[] newV1 = Encoding.UTF8.GetBytes(TomlSerializer.Serialize(v1Document, CargoTomlContext.Default.TomlTable));
+        byte[] newV2 = CargoJson.SerializeToUtf8Bytes(v2Document);
+        if (newV1.Length > CargoHttp.ManifestLimit || newV2.Length > CargoHttp.ManifestLimit)
+            throw new InvalidDataException("Updated Cargo tracking metadata exceeds the allowed size.");
+        string transaction = Path.Join(root, TransactionDirectory);
+        CargoConfiguration.RequireRegularPath(transaction);
+        Directory.CreateDirectory(transaction);
+        CargoTransactionJournal journal = new(
+            affected.Select(name =>
+            {
+                string path = Path.Join(binDirectory, name);
+                bool exists = File.Exists(path);
+                return new CargoTransactionEntry(name, exists,
+                    exists && !OperatingSystem.IsWindows() ? (int)File.GetUnixFileMode(path) : null,
+                    binaries.TryGetValue(name, out byte[]? content) ? Hash(content) : null);
+            }).ToArray(),
+            false, Hash(newV1), Hash(newV2));
+        // The journal is durable before the first installed binary or tracking file changes.
+        try
+        {
+            WriteDurable(Path.Join(transaction, "metadata-v1"), oldV1);
+            WriteDurable(Path.Join(transaction, "metadata-v2"), oldV2);
+            for (int i = 0; i < journal.Entries.Length; i++)
+            {
+                var entry = journal.Entries[i];
+                if (entry.Existed)
+                    WriteDurable(Path.Join(transaction, $"backup-{i}"), File.ReadAllBytes(Path.Join(binDirectory, entry.Name)));
+            }
+            WriteJournal(transaction, journal);
+        }
+        catch
+        {
+            Cleanup(transaction);
+            throw;
+        }
+        try
+        {
+            foreach (string name in affected)
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+                string destination = Path.Join(binDirectory, name);
+                CargoConfiguration.RequireRegularPath(destination);
+                if (binaries.TryGetValue(name, out byte[]? content))
+                {
+                    string staged = Path.Join(transaction, "staged-binary");
+                    WriteDurable(staged, content);
+                    if (!OperatingSystem.IsWindows())
+                        File.SetUnixFileMode(staged, UnixFileMode.UserRead | UnixFileMode.UserWrite
+                            | UnixFileMode.UserExecute | UnixFileMode.GroupRead | UnixFileMode.GroupExecute
+                            | UnixFileMode.OtherRead | UnixFileMode.OtherExecute);
+                    File.Move(staged, destination, overwrite: true);
+                }
+                else if (File.Exists(destination))
+                    File.Delete(destination);
+            }
+            cancellationToken.ThrowIfCancellationRequested();
+            WriteLocked(metadata.V1, newV1);
+            WriteLocked(metadata.V2, newV2);
+            WriteJournal(transaction, journal with { Committed = true });
+        }
+        catch (Exception operationError)
+        {
+            try { Recover(root, metadata); }
+            catch (Exception rollbackError)
+            {
+                throw new AggregateException("Cargo installation failed and could not be rolled back.",
+                    operationError, rollbackError);
+            }
+            throw;
+        }
+        Cleanup(transaction);
+    }
+
+    internal static string[] ReadBins(object? value)
+    {
+        if (value is not TomlArray array || array.Any(item => item is not string))
+            throw new InvalidDataException("Invalid binary list in Cargo installation metadata.");
+        return array.Cast<string>().ToArray();
+    }
+
+    private static void Recover(string root, CargoTrackingLock metadata)
+    {
+        string transaction = Path.Join(root, TransactionDirectory);
+        if (!Directory.Exists(transaction))
+            return;
+        CargoConfiguration.RequireRegularPath(transaction);
+        if (!Directory.EnumerateFileSystemEntries(transaction).Any())
+        {
+            Directory.Delete(transaction);
+            return;
+        }
+        string journalPath = Path.Join(transaction, "journal.json");
+        CargoConfiguration.RequireRegularPath(journalPath);
+        if (!File.Exists(journalPath))
+            throw new IOException($"Incomplete Cargo transaction needs inspection before installation: {transaction}");
+        var journal = CargoJson.Deserialize<CargoTransactionJournal>(File.ReadAllText(journalPath))
+            ?? throw new InvalidDataException("Cargo transaction journal is empty.");
+        if (!journal.Committed)
+        {
+            // Cargo may have acquired the locks and installed something else after a crash.
+            // Never roll an interrupted transaction back over those later external changes.
+            foreach (string name in new[] { "metadata-v1", "metadata-v2" })
+                CargoConfiguration.RequireRegularPath(Path.Join(transaction, name));
+            byte[] originalV1 = File.ReadAllBytes(Path.Join(transaction, "metadata-v1"));
+            byte[] originalV2 = File.ReadAllBytes(Path.Join(transaction, "metadata-v2"));
+            if (!MatchesTransaction(Read(metadata.V1), originalV1, journal.V1Hash)
+                || !MatchesTransaction(Read(metadata.V2), originalV2, journal.V2Hash))
+                throw new IOException($"Cargo metadata changed after an interrupted transaction; inspect {transaction} before recovery.");
+            string binDirectory = Path.Join(root, "bin");
+            for (int i = 0; i < journal.Entries.Length; i++)
+            {
+                var entry = journal.Entries[i];
+                CargoBinaryResolver.ValidateBinaryName(entry.Name);
+                string destination = Path.Join(binDirectory, entry.Name);
+                CargoConfiguration.RequireRegularPath(destination);
+                if (!File.Exists(destination))
+                    continue;
+                string backup = Path.Join(transaction, $"backup-{i}");
+                if (entry.Existed)
+                    CargoConfiguration.RequireRegularPath(backup);
+                byte[]? original = entry.Existed ? File.ReadAllBytes(backup) : null;
+                byte[] current = File.ReadAllBytes(destination);
+                if ((original is null || !current.AsSpan().SequenceEqual(original))
+                    && Hash(current) != entry.InstalledHash)
+                    throw new IOException($"Cargo executable {entry.Name} changed after an interrupted transaction; manual recovery is required.");
+            }
+            for (int i = 0; i < journal.Entries.Length; i++)
+            {
+                var entry = journal.Entries[i];
+                CargoBinaryResolver.ValidateBinaryName(entry.Name);
+                string destination = Path.Join(binDirectory, entry.Name);
+                CargoConfiguration.RequireRegularPath(destination);
+                if (entry.Existed)
+                {
+                    string backup = Path.Join(transaction, $"backup-{i}");
+                    CargoConfiguration.RequireRegularPath(backup);
+                    if (!File.Exists(destination)
+                        || !File.ReadAllBytes(destination).AsSpan().SequenceEqual(File.ReadAllBytes(backup)))
+                        File.Copy(backup, destination, overwrite: true);
+                    if (!OperatingSystem.IsWindows() && entry.UnixMode is { } mode)
+                        File.SetUnixFileMode(destination, (UnixFileMode)mode);
+                }
+
+                else if (File.Exists(destination))
+                    File.Delete(destination);
+            }
+            WriteLocked(metadata.V1, originalV1);
+            WriteLocked(metadata.V2, originalV2);
+            WriteJournal(transaction, journal with { Committed = true });
+            Logger.Warn("Rolled back an interrupted UniGetUI Cargo installation.");
+        }
+        Cleanup(transaction);
+    }
+
+    private static string Hash(byte[] data) => Convert.ToHexString(SHA256.HashData(data));
+
+    private static bool MatchesTransaction(byte[] current, byte[] original, string? installedHash) =>
+        current.AsSpan().SequenceEqual(original) || Hash(current) == installedHash;
+
+    private static byte[] Read(FileStream stream)
+    {
+        if (stream.Length > CargoHttp.ManifestLimit)
+            throw new InvalidDataException("Cargo tracking metadata exceeds the allowed size.");
+        stream.Position = 0;
+        byte[] bytes = new byte[stream.Length];
+        stream.ReadExactly(bytes);
+        return bytes;
+    }
+
+    private static void WriteLocked(FileStream stream, byte[] data)
+    {
+        stream.Position = 0;
+        stream.Write(data);
+        stream.SetLength(data.Length);
+        stream.Flush(flushToDisk: true);
+    }
+
+    private static void WriteDurable(string path, byte[] data)
+    {
+        CargoConfiguration.RequireRegularPath(path);
+        using FileStream stream = new(path, FileMode.Create, FileAccess.Write, FileShare.None);
+        stream.Write(data);
+        stream.Flush(flushToDisk: true);
+    }
+
+    private static void WriteJournal(string transaction, CargoTransactionJournal journal)
+    {
+        string temporary = Path.Join(transaction, "journal.tmp");
+        WriteDurable(temporary, CargoJson.SerializeToUtf8Bytes(journal));
+        File.Move(temporary, Path.Join(transaction, "journal.json"), overwrite: true);
+    }
+
+    private static void Cleanup(string transaction)
+    {
+        foreach (string path in Directory.EnumerateFileSystemEntries(transaction)
+            .OrderBy(path => Path.GetFileName(path) == "journal.json" ? 1 : 0))
+        {
+            CargoConfiguration.RequireRegularPath(path);
+            if (Directory.Exists(path))
+                throw new InvalidDataException("Unexpected directory in the Cargo transaction.");
+            File.Delete(path);
+        }
+        Directory.Delete(transaction);
+    }
+}
