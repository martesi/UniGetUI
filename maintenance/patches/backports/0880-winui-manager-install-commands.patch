   "Release date": "Release date",
   "Fit columns to the window": "Fit columns to the window",
+  "Install it with this command:": "Install it with this command:",
+  "Copy command": "Copy command",
+  "Open in a terminal": "Open in a terminal",
+  "The install command was copied to the clipboard. Paste it into the terminal to run it.": "The install command was copied to the clipboard. Paste it into the terminal to run it.",
+  "The install command was copied to the clipboard, but no terminal could be opened.": "The install command was copied to the clipboard, but no terminal could be opened.",
   "How to set up {0}": "How to set up {0}"
 }
diff --git a/src/UniGetUI.PackageEngine.Interfaces/ManagerInstallCommands.cs b/src/UniGetUI.PackageEngine.Interfaces/ManagerInstallCommands.cs
new file mode 100644
--- /dev/null
+++ b/src/UniGetUI.PackageEngine.Interfaces/ManagerInstallCommands.cs
@@ -0,0 +1,16 @@
+namespace UniGetUI.PackageEngine.ManagerClasses.Manager
+{
+    public readonly record struct ManagerInstallCommands(
+        string? Windows = null,
+        string? MacOS = null,
+        string? Linux = null
+    )
+    {
+        public string? ForCurrentPlatform() =>
+            OperatingSystem.IsWindows()
+                ? Windows
+                : OperatingSystem.IsMacOS()
+                    ? MacOS
+                    : Linux;
+    }
+}
