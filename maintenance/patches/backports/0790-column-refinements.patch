From 19f793289057e0fd17fe870b04a99e8b80ba6562 Mon Sep 17 00:00:00 2001
From: martesi <96113508+martesi@users.noreply.github.com>
Date: Mon, 2 Nov 2026 13:19:41 -0800
Subject: [PATCH] fix: keep package columns responsive and synchronized

Upstream-PR: Devolutions/UniGetUI#5623
Upstream-PR: Devolutions/UniGetUI#5632
Classic-Source-Commit: 630d5668bbe6d33f7aa7a4e9082eaf4a8add30c5
---
 src/UniGetUI/Controls/PackageWrapper.cs       |  4 +-
 .../SoftwarePages/AbstractPackagesPage.xaml   |  2 +-
 .../AbstractPackagesPage.xaml.cs              |  3 +
 testing/automation/run-winui-ui-e2e.ps1       | 60 +++++++++++++++----
 4 files changed, 54 insertions(+), 15 deletions(-)

diff --git a/src/UniGetUI/Controls/PackageWrapper.cs b/src/UniGetUI/Controls/PackageWrapper.cs
index d5b9ff5..71da8ff 100644
--- a/src/UniGetUI/Controls/PackageWrapper.cs
+++ b/src/UniGetUI/Controls/PackageWrapper.cs
@@ -109,6 +109,7 @@ namespace UniGetUI.PackageEngine.PackageClasses
 
         public void NotifyColumnVisibilityChanged()
         {
+            if (!_listRowRealized) return;
             foreach (string property in new[]
             {
                 nameof(NameColumnWidth), nameof(IdColumnWidth), nameof(VersionColumnWidth),
@@ -162,7 +163,8 @@ namespace UniGetUI.PackageEngine.PackageClasses
                     OptionalDetailsGate.Release();
                 }
                 token.ThrowIfCancellationRequested();
-                InstallerHostText = details.InstallerUrl?.Host is { Length: > 0 } host ? host : "—";
+                InstallerHostText = details.InstallerUrl is { IsAbsoluteUri: true } uri
+                    && !string.IsNullOrWhiteSpace(uri.Host) ? uri.Host : "—";
                 DownloadSizeBytes = details.InstallerSize;
                 DownloadSizeText = DownloadSizeBytes > 0 ? CoreTools.FormatAsSize(DownloadSizeBytes) : "—";
                 ReleaseDate = DateTime.TryParse(details.UpdateDate, CultureInfo.InvariantCulture,
diff --git a/src/UniGetUI/Pages/SoftwarePages/AbstractPackagesPage.xaml b/src/UniGetUI/Pages/SoftwarePages/AbstractPackagesPage.xaml
index 293ef68..4d4f521 100644
--- a/src/UniGetUI/Pages/SoftwarePages/AbstractPackagesPage.xaml
+++ b/src/UniGetUI/Pages/SoftwarePages/AbstractPackagesPage.xaml
@@ -1086,13 +1086,13 @@
             />
             <Button
               Name="NewVersionHeader"
+              AutomationProperties.AutomationId="NewVersionHeader"
               Grid.Column="8"
               Grid.ColumnSpan="2"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               BorderThickness="0"
               CornerRadius="0"
-              Visibility="{x:Bind RoleIsUpdateLike}"
             />
             <Button
               Name="SourceHeader"
diff --git a/src/UniGetUI/Pages/SoftwarePages/AbstractPackagesPage.xaml.cs b/src/UniGetUI/Pages/SoftwarePages/AbstractPackagesPage.xaml.cs
index 2b5cab7..870b4ea 100644
--- a/src/UniGetUI/Pages/SoftwarePages/AbstractPackagesPage.xaml.cs
+++ b/src/UniGetUI/Pages/SoftwarePages/AbstractPackagesPage.xaml.cs
@@ -1212,6 +1212,9 @@ namespace UniGetUI.Interface
             }
 
             FilteredPackages.FromRange(matchingList_selectedSources);
+            if (FilteredPackages.CurrentSorter is ObservablePackageCollection.Sorter.DownloadSize
+                or ObservablePackageCollection.Sorter.ReleaseDate)
+                _ = LoadDetailsAndSortAsync(FilteredPackages.CurrentSorter);
             UpdatePackageCount();
 
             if (previousSelection is not null)
diff --git a/testing/automation/run-winui-ui-e2e.ps1 b/testing/automation/run-winui-ui-e2e.ps1
index f24450a..c6d0f35 100644
--- a/testing/automation/run-winui-ui-e2e.ps1
+++ b/testing/automation/run-winui-ui-e2e.ps1
@@ -86,6 +86,24 @@ function Invoke-Element {
     [System.Windows.Forms.SendKeys]::SendWait('{ENTER}')
 }
 
+function Toggle-Column {
+    param([System.Windows.Automation.AutomationElement] $Root, [string] $Column)
+
+    Invoke-Element (Find-ElementByAutomationId $Root 'OrderByButton')
+    $columnsMenu = Find-ElementByAutomationId $Root 'ColumnsMenu'
+    try {
+        $expand = [System.Windows.Automation.ExpandCollapsePattern]$columnsMenu.GetCurrentPattern(
+            [System.Windows.Automation.ExpandCollapsePattern]::Pattern
+        )
+        $expand.Expand()
+    }
+    catch {
+        $columnsMenu.SetFocus()
+        [System.Windows.Forms.SendKeys]::SendWait('{RIGHT}')
+    }
+    Invoke-Element (Find-ElementByAutomationId $Root "Column$Column")
+}
+
 function Find-ToggleByAutomationId {
     param(
         [System.Windows.Automation.AutomationElement] $Root,
@@ -241,19 +259,7 @@ try {
         -ArgumentList 'unigetui://showDiscoverPage' -PassThru
     $root = [System.Windows.Automation.AutomationElement]::RootElement
     $query = Find-ElementByAutomationId $root 'MegaQueryBlock' -TimeoutSeconds 120
-    Invoke-Element (Find-ElementByAutomationId $root 'OrderByButton')
-    $columnsMenu = Find-ElementByAutomationId $root 'ColumnsMenu'
-    try {
-        $expand = [System.Windows.Automation.ExpandCollapsePattern]$columnsMenu.GetCurrentPattern(
-            [System.Windows.Automation.ExpandCollapsePattern]::Pattern
-        )
-        $expand.Expand()
-    }
-    catch {
-        $columnsMenu.SetFocus()
-        [System.Windows.Forms.SendKeys]::SendWait('{RIGHT}')
-    }
-    Invoke-Element (Find-ElementByAutomationId $root 'ColumnReleaseDate')
+    Toggle-Column $root 'ReleaseDate'
     [void](Find-ElementByAutomationId $root 'ReleaseDateHeader')
     $value = [System.Windows.Automation.ValuePattern]$query.GetCurrentPattern(
         [System.Windows.Automation.ValuePattern]::Pattern
@@ -278,6 +284,34 @@ try {
     if (-not $dateFound) { throw 'A package release date was not displayed.' }
     Invoke-Element (Find-ElementByAutomationId $root 'ReleaseDateHeader')
 
+    Write-Host 'Checking the New version column on Updates'
+    $null = Start-Process -FilePath $executable -WorkingDirectory (Split-Path $executable) `
+        -ArgumentList 'unigetui://showUpdatesPage' -PassThru
+    [void](Find-ElementByAutomationId $root 'NewVersionHeader' -TimeoutSeconds 120)
+    Toggle-Column $root 'NewVersion'
+    $headerCondition = [System.Windows.Automation.PropertyCondition]::new(
+        [System.Windows.Automation.AutomationElement]::AutomationIdProperty, 'NewVersionHeader'
+    )
+    $deadline = (Get-Date).AddSeconds(15)
+    do {
+        $header = $root.FindFirst([System.Windows.Automation.TreeScope]::Descendants, $headerCondition)
+        if (-not $header -or $header.Current.IsOffscreen) { break }
+        Start-Sleep -Milliseconds 250
+    } while ((Get-Date) -lt $deadline)
+    if ($header -and -not $header.Current.IsOffscreen) {
+        throw 'The New version column did not hide.'
+    }
+    Toggle-Column $root 'NewVersion'
+    $deadline = (Get-Date).AddSeconds(15)
+    do {
+        $header = $root.FindFirst([System.Windows.Automation.TreeScope]::Descendants, $headerCondition)
+        if ($header -and -not $header.Current.IsOffscreen) { break }
+        Start-Sleep -Milliseconds 250
+    } while ((Get-Date) -lt $deadline)
+    if (-not $header -or $header.Current.IsOffscreen) {
+        throw 'The New version column did not appear again.'
+    }
+
     Stop-Process -Id $appProcess.Id -Force -ErrorAction SilentlyContinue
     Wait-Process -Id $appProcess.Id -ErrorAction SilentlyContinue
     $appProcess = Start-Process -FilePath $executable -WorkingDirectory (Split-Path $executable) `
-- 
