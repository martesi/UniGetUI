From cb7b1514ca4054bc0dbb6cfb2eee4ad8b7848aa8 Mon Sep 17 00:00:00 2001
From: Classic maintenance <classic-maintenance@example.invalid>
Date: Mon, 2 Nov 2026 17:31:39 +0200
Subject: [PATCH] fix: keep portable session logs in the portable folder

Classic-Source-Commit: d6f897fbec73e71dc2a64026b1bfe79930ed6547
---
 src/UniGetUI.Core.Logger/Logger.cs             | 13 ++++---------
 src/UniGetUI.Core.Logging.Tests/LoggerTests.cs | 11 ++++++-----
 2 files changed, 10 insertions(+), 14 deletions(-)

diff --git a/src/UniGetUI.Core.Logger/Logger.cs b/src/UniGetUI.Core.Logger/Logger.cs
index 3d2e744..a6bebc3 100644
--- a/src/UniGetUI.Core.Logger/Logger.cs
+++ b/src/UniGetUI.Core.Logger/Logger.cs
@@ -6,18 +6,12 @@ namespace UniGetUI.Core.Logging
     {
         private static readonly List<LogEntry> LogContents = [];
         private static readonly Lock LogWriteLock = new();
-        private static readonly string SessionLogPath = Path.Combine(
-            Path.GetTempPath(),
-            "UniGetUI",
-            "session.log"
-        );
-
         private static readonly string UserName = Environment.UserName;
 
         // When enabled, the current user's name is replaced by **** in every logged line (privacy).
         public static bool RedactUsername { get; set; }
 
-        public static string GetSessionLogPath() => SessionLogPath;
+        public static string GetSessionLogPath() => Path.Join(AppPaths.ScratchDirectory, "session.log");
 
         // Replaces the current user's name with **** when redaction is enabled (privacy).
         // Public so other diagnostic surfaces (operation output, crash reports, update logs)
@@ -45,11 +39,12 @@ namespace UniGetUI.Core.Logging
         {
             try
             {
-                Directory.CreateDirectory(Path.GetDirectoryName(SessionLogPath)!);
+                string sessionLogPath = GetSessionLogPath();
+                Directory.CreateDirectory(Path.GetDirectoryName(sessionLogPath)!);
                 lock (LogWriteLock)
                 {
                     File.AppendAllText(
-                        SessionLogPath,
+                        sessionLogPath,
                         $"[{DateTime.Now:yyyy-MM-dd h:mm:ss tt}] {text}{Environment.NewLine}"
                     );
                 }
diff --git a/src/UniGetUI.Core.Logging.Tests/LoggerTests.cs b/src/UniGetUI.Core.Logging.Tests/LoggerTests.cs
index 250a559..e3511ca 100644
--- a/src/UniGetUI.Core.Logging.Tests/LoggerTests.cs
+++ b/src/UniGetUI.Core.Logging.Tests/LoggerTests.cs
@@ -6,6 +6,7 @@ namespace UniGetUI.Core.Logging.Tests
         [Fact]
         public void TestLogger()
         {
+            int initialCount = Logger.GetLogs().Length;
             DateTime startTime = DateTime.Now;
             Logger.Info("Hello World");
             Logger.Debug("Hello World 2");
@@ -14,7 +15,7 @@ namespace UniGetUI.Core.Logging.Tests
 
             DateTime endTime = DateTime.Now;
 
-            LogEntry[] logs = Logger.GetLogs();
+            LogEntry[] logs = Logger.GetLogs().Skip(initialCount).ToArray();
 
             Assert.Equal("Hello World", logs[0].Content);
             Assert.Equal("Hello World 2", logs[1].Content);
@@ -26,10 +27,10 @@ namespace UniGetUI.Core.Logging.Tests
             Assert.Equal(LogEntry.SeverityLevel.Error, logs[2].Severity);
             Assert.Equal(LogEntry.SeverityLevel.Warning, logs[3].Severity);
 
-            Assert.True(logs[0].Time > startTime && logs[0].Time < endTime);
-            Assert.True(logs[1].Time > startTime && logs[1].Time < endTime);
-            Assert.True(logs[2].Time > startTime && logs[2].Time < endTime);
-            Assert.True(logs[3].Time > startTime && logs[3].Time < endTime);
+            Assert.InRange(logs[0].Time, startTime, endTime);
+            Assert.InRange(logs[1].Time, startTime, endTime);
+            Assert.InRange(logs[2].Time, startTime, endTime);
+            Assert.InRange(logs[3].Time, startTime, endTime);
         }
     }
 }
