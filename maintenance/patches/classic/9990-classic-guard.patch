From: Martes <96113508+martesi@users.noreply.github.com>
Date: Fri, 28 Aug 2026 19:27:31 +0800
Subject: [PATCH] classic: enforce Classic invariants in CI

Classic-Source-Commit: b1cad070a55426a0e4002ff2fe20b767438b5b46
Classic-Source-Commit: b1801147a1affb9af7532d3a2d8162302c1e3954
Classic-Source-Commit: 6007852ebccb49392e48a60f836d7edcf7d98533
Classic-Source-Commit: 88a18559ae3046d0040a773cf517e5f7099fa235
Classic-Source-Commit: 183ea5fe069366c836a410aa6738734cd892b1e8
---
 .github/workflows/classic-guard.yml | 131 ++++++++++++++++++++++++++++
 1 file changed, 131 insertions(+)
 create mode 100644 .github/workflows/classic-guard.yml

diff --git a/.github/workflows/classic-guard.yml b/.github/workflows/classic-guard.yml
new file mode 100644
index 000000000..367f890dc
--- /dev/null
+++ b/.github/workflows/classic-guard.yml
@@ -0,0 +1,131 @@
+name: Classic guard
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+    branches: [main]
+
+permissions:
+  contents: read
+
+jobs:
+  policy:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v6
+
+      - name: Verify Classic base metadata
+        shell: bash
+        run: |
+          set -euo pipefail
+          grep -q '"base_tag": "v2026.2.1"' maintenance/upstream-base.json
+          grep -q '"base_commit": "68411409d001b9f34cfb896af1543a1d7067ca5e"' maintenance/upstream-base.json
+
+      - name: Verify Avalonia bundling stays disabled
+        shell: bash
+        run: |
+          set -euo pipefail
+          grep -q '<BundleModernApp>false</BundleModernApp>' src/Directory.Build.targets
+
+      - name: Verify Classic always launches WinUI
+        shell: bash
+        run: |
+          set -euo pipefail
+          entrypoint='src/UniGetUI/EntryPoint.cs'
+          grep -Fq 'UniGetUI Classic is WinUI-only.' "$entrypoint"
+          grep -Fq 'CoreData.WasDaemon = CoreData.IsDaemon = args.Contains(CLIHandler.DAEMON);' "$entrypoint"
+          if grep -Fq 'ModernAppLauncher.Launch(args)' "$entrypoint"; then
+            echo 'Classic entry point must not hand UI startup to the unbundled Avalonia frontend.' >&2
+            exit 1
+          fi
+
+      - name: Verify Classic exposes no frontend switch
+        shell: bash
+        run: |
+          set -euo pipefail
+          if grep -R -Fq 'SettingName="UseClassicMode"' src/UniGetUI --include='*.xaml'; then
+            echo 'Classic is WinUI-only and must not expose a frontend-selection switch.' >&2
+            exit 1
+          fi
+
+      - name: Verify Classic updater identity
+        shell: bash
+        run: |
+          set -euo pipefail
+          updater='src/UniGetUI/AutoUpdater.Helpers.cs'
+          grep -q 'Software\\martesi\\UniGetUIClassic' "$updater"
+          grep -q 'github.com/martesi/UniGetUI/releases/latest/download/productinfo.json' "$updater"
+          grep -q 'martesi.UniGetUI.Classic' "$updater"
+
+      - name: Verify separate installed app identity
+        shell: bash
+        run: |
+          set -euo pipefail
+          installer='UniGetUI.iss'
+          core='src/UniGetUI.Core.Data/CoreData.cs'
+
+          grep -Fq '#define MyAppName "UniGetUI Classic"' "$installer"
+          grep -Fq '#define MyAppPublisher "Martes"' "$installer"
+          grep -Fq '#define MyAppURL "https://github.com/martesi/UniGetUI"' "$installer"
+          grep -Fq 'AppId={{E385AFF5-90A4-4296-8702-EC129F9DC40B}' "$installer"
+          if grep -Fq '889610CC-4337-4BDB-AC3B-4F21806C0BDE' "$installer"; then
+            echo 'Classic must not reuse the upstream Inno AppId.' >&2
+            exit 1
+          fi
+          grep -Fq 'DefaultDirName="{autopf64}\UniGetUI Classic"' "$installer"
+          grep -Fq 'ValueName: "UniGetUIClassic"' "$installer"
+          if grep -Fq '/f /im UniGetUI.exe' "$installer" || grep -Fq "TaskKillWait('UniGetUI.exe')" "$installer"; then
+            echo 'Classic installer must not kill upstream UniGetUI by image name.' >&2
+            exit 1
+          fi
+          if grep -Fq -- '--migrate-wingetui-to-unigetui' "$installer"; then
+            echo 'Classic installer must not run the upstream WingetUI migration.' >&2
+            exit 1
+          fi
+
+          grep -Fq 'Software\Classes\unigetui' "$installer"
+          grep -Fq 'UniGetUI.PackageBundle' "$installer"
+          grep -Fq 'Check: ShouldRegisterUniGetUIProtocol;' "$installer"
+          grep -Fq 'Check: ShouldRegisterPackageBundle;' "$installer"
+          grep -Fq 'function ClassicOwnsRegistryCommand' "$installer"
+          grep -Fq 'procedure CurUninstallStepChanged' "$installer"
+          if grep -E 'Software\\Classes\\(unigetui|UniGetUI\.PackageBundle).*uninsdeletekey' "$installer"; then
+            echo 'Shared Classic/upstream handler keys must not be deleted unconditionally.' >&2
+            exit 1
+          fi
+
+          grep -Fq 'Martes.UniGetUIClassic' "$core"
+          grep -Fq 'Martes.UniGetUIClassic.MainInterface' "$core"
+          grep -Fq 'Path.Join(GetLocalDataRoot(), "UniGetUIClassic")' "$core"
+          grep -Fq 'github.com/martesi/UniGetUI/releases/tag/' "$core"
+
+      - name: Verify hash-only release policy
+        shell: bash
+        run: |
+          set -euo pipefail
+          updater='src/UniGetUI/AutoUpdater.Helpers.cs'
+          # Release UpdaterOverrides must keep hash validation enabled (false) and signer validation skipped (true).
+          grep -A8 'Classic releases are currently unsigned' "$updater" | grep -q 'false,'
+          grep -A10 'Classic releases are currently unsigned' "$updater" | grep -q 'true,'
+          test -s .github/workflows/classic-release.yml
+          grep -q 'productinfo.json' .github/workflows/classic-release.yml
+          grep -q 'Get-FileHash .*SHA256' .github/workflows/classic-release.yml
+
+      - name: Verify maintenance ledger exists
+        shell: bash
+        run: |
+          set -euo pipefail
+          test -s maintenance/backports.yml
+          test -s maintenance/PATCH_POLICY.md
+          test -s CLASSIC.md
+
+      - name: Block accidental upstream merge commits
+        if: github.event_name == 'pull_request'
+        shell: bash
+        run: |
+          set -euo pipefail
+          if git log --merges --pretty='%P' "origin/${{ github.base_ref }}..HEAD" | awk 'NF > 2 { found=1 } END { exit found ? 0 : 1 }'; then
+            echo 'Merge commits detected in Classic changes. Import upstream fixes selectively instead of merging upstream.' >&2
+            exit 1
+          fi
