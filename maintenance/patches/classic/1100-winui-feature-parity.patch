@@ -0,0 +1,17 @@
+namespace UniGetUI.Interface;
+
+internal static class CsvExportHelpers
+{
+    internal static string EscapeField(string? field)
+    {
+        field ??= "";
+
+        if (field.Length > 0 && "=+-@\t\r".Contains(field[0]))
+            field = "'" + field;
+
+        if (field.IndexOfAny(['"', ',', '\n', '\r']) >= 0)
+            return "\"" + field.Replace("\"", "\"\"") + "\"";
+
+        return field;
+    }
+}
