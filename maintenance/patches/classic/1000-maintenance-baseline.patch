+  "classic_branch": "main",
+  "base_tag": "v2026.2.1",
+  "base_commit": "68411409d001b9f34cfb896af1543a1d7067ca5e",
+  "policy": "selective-backport"
+}
diff --git a/src/Directory.Build.targets b/src/Directory.Build.targets
new file mode 100644
index 000000000..baf17c897
--- /dev/null
+++ b/src/Directory.Build.targets
@@ -0,0 +1,10 @@
+<Project>
+  <!--
+    UniGetUI Classic intentionally ships the WinUI frontend from the v2026.2.1 base.
+    Upstream v2026.2.1 can bundle the Avalonia frontend during publish; force that
+    downstream-only option off without modifying the upstream project file.
+  -->
+  <PropertyGroup>
+    <BundleModernApp>false</BundleModernApp>
+  </PropertyGroup>
+</Project>
